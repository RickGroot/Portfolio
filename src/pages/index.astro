---
import BaseLayout from '@layouts/BaseLayout.astro';
import CharacterField from '@components/CharacterField.astro';
import Section from '@components/Section.astro';
import Guide from '@components/Guide.astro';
import ArtSection from '@components/ArtSection.astro';
import { practice } from '@lib/practice';
import { Image } from 'astro:assets';
import artSignal from '@assets/art/lighthouse.jpg';
import artField from '@assets/art/tower.jpg';
import talkPhoto from '@assets/talk.jpg';
import aboutPhoto from '@assets/about.jpg';
import SocialLinks from '@components/SocialLinks.astro';
import { getPublishedWork } from '@lib/work';
import { site } from '@lib/site';
import { channelStyle } from '@lib/channels';

// Every published entry: the guide is the complete record.
const published = await getPublishedWork();

/*
 * The rail mirrors the document order exactly. It is built from one list so the
 * two cannot drift -- a rail dot pointing at an id that moved is a dead link
 * that nothing would catch.
 */
const rail = [
	{ id: 'top', label: 'Top' },
	{ id: 'work', label: 'Work' },
	{ id: 'interlude-signal', label: 'Interlude' },
	{ id: 'practice', label: 'How I work' },
	{ id: 'interlude-field', label: 'Interlude' },
	{ id: 'contact', label: 'Contact' },
];
---

<BaseLayout title={site.name} description={site.description} bleed>
	<nav class="rail" data-rail aria-label="Sections">
		{rail.map((s) => (
			<a href={`#${s.id}`}>
				<span class="visually-hidden">{s.label}</span>
			</a>
		))}
	</nav>

	{/* ---- Masthead: the test card ---- */}
	<section
		id="top"
		class="section hero"
		aria-labelledby="top-heading"
		data-section
		data-channel="ink"
		data-osd="Rick Groot"
		style={channelStyle('ink')}
	>
		<CharacterField />
		<span class="hero__castle hero__castle--start" aria-hidden="true"></span>
		<span class="hero__castle hero__castle--end" aria-hidden="true"></span>
		{/* Real state: the visitor's own time, as the guide's clock is. Filled */}
		{/* and shown by src/scripts/testcard.ts, so without JavaScript there is */}
		{/* no clock rather than a stopped one. */}
		<p class="hero__clock" data-hero-clock aria-hidden="true" hidden></p>
		<div class="hero__card">
			<div class="hero__id">
				<h1 id="top-heading" data-decode>
					Rick Groot
				</h1>
				<p class="hero__role">Connected TV developer</p>
			</div>
			<span class="hero__bars" aria-hidden="true"></span>
			<p class="hero__lede">
				I build Connected TV apps at Hypersolid, from NLZIET on Smart TVs to Chromecast receivers
				and the video players underneath them. Most of it is performance work: the devices they run
				on are older and slower than the machine I write on.
			</p>
		</div>
	</section>

	{/* ---- Work: the programme guide ---- */}
	<Guide entries={published} />

	<ArtSection
		id="interlude-signal"
		image={artSignal}
		alt="A lighthouse and a small group of people silhouetted against a sunset over a bay."
		focus="40% 50%"
		lift={1.45}
		contrast={1.35}
		statement="A TV app has to feel fast on hardware that shipped years before the app did."
		caption="Interlude / Signal"
		channel="yellow"
	/>

	{/* ---- How I work ---- */}
	<Section id="practice" label="How I work" class="section--backdrop" channel="paper">
		{/* Rick presenting, standing at the left; his three points sit to his */}
		{/* right on wide screens, so the cards never cover his face. The slide */}
		{/* and both audience members are blurred in the source file itself. */}
		<div class="practice__backdrop duo" style="--duo-lift:1.2;--duo-contrast:1.15">
			<Image
				src={talkPhoto}
				alt="Rick giving a talk, in front of a bright, blank projection screen."
				widths={[800, 1200, 1600]}
				sizes="100vw"
				loading="lazy"
				decoding="async"
			/>
			<span class="practice__fade" aria-hidden="true"></span>
		</div>
		<p class="practice__lede">
			I work AI-first. Three principles keep it honest, each with its proof from building this site.
		</p>
		<ol class="practice">
			{practice.map((item) => (
				<li class="practice__item">
					<p class="practice__index" aria-hidden="true">
						{item.index}
					</p>
					<h3 class="practice__title">{item.title}</h3>
					<p class="practice__body">{item.body}</p>
					<p class="practice__proof">{item.proof}</p>
				</li>
			))}
		</ol>
	</Section>

	{/* U+2060 WORD JOINER holds "re-run" together at a line end. The non-breaking */}
	{/* hyphen this used before, U+2011, was missing from an earlier display subset. */}
	<ArtSection
		id="interlude-field"
		image={artField}
		alt="A stone clock tower against a bright, empty sky."
		focus="36% 45%"
		statement={'Every measurement quoted on this site can be re-\u2060run from the repository.'}
		caption="Interlude / Field"
		channel="ultramarine"
	/>

	{/* ---- Contact ---- */}
	<Section id="contact" label="Contact" channel="paper">
		<div class="contact">
			<div class="contact__text">
				<p class="lede">
					Email is easiest. Happy to talk about Connected TV work, or the trumpet if you would
					rather.
				</p>
				<SocialLinks />
			</div>
			<figure class="contact__photo duo">
				{/* Quality 72: the retouched photo is all fine detail, sky and water, and at */}
				{/* the default it came out over the 150 KB mark for one picture at 30vw. */}
				<Image
					src={aboutPhoto}
					alt="Rick Groot, smiling, on a bridge by a canal."
					widths={[500, 800, 1000]}
					sizes="(min-width: 52rem) 30vw, 90vw"
					quality={72}
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</Section>

	<script>
		import { boot } from '../scripts/sections';
		import { boot as bootZap } from '../scripts/zap';
		import { boot as bootTestcard } from '../scripts/testcard';
		import { decode } from '../lib/decode';
		boot();
		bootZap();
		bootTestcard();
		// The name tunes in with the portrait on first sight -- once the display
		// face is in, so each letter is measured in it rather than in the fallback.
		// Not on a deep link that lands further down the page.
		void document.fonts.ready.then(() => {
			if (window.scrollY < window.innerHeight / 2) decode(document.getElementById('top-heading'));
		});
	</script>
</BaseLayout>

<style>
	/* ---- Masthead: the test card ------------------------------------------ */

	/*
	 * Channel 01 is the card a television shows before the programmes start
	 * (Rick, 2026-09-28, of three candidates: this, a transmission of rings, and
	 * a yellow poster). The grid runs edge to edge, drawn in characters by the
	 * field; the circle stands in the middle with the face in it; the name, the
	 * colour bars and the synopsis are the card's boxes, one plate under the
	 * chin; the clock is in the box on the top of the circle.
	 *
	 * The geometry is here and only here. The field reads it through a probe
	 * (src/lib/field/field.ts), and the boxes are laid out from it before any
	 * script runs, so the handover to the live card cannot move one.
	 *   --ring-cy  the circle's centre, down from the top of the hero
	 *   --ring-r   its radius
	 *   --face-cy  the face's centre: above the circle's on a wide screen, so
	 *              the name's box crosses the chin rather than the smile
	 *   --grid     the grid's step
	 *   --card-at  where the name's box starts, in radii below the centre
	 */
	.hero {
		--ring-cy: 47svh;
		--ring-r: min(43svh, 38vw);
		--face-cy: calc(var(--ring-cy) - var(--ring-r) * 0.14);
		--grid: calc(100svh / 8.4);
		--card-at: 0.36;
		position: relative;
		display: grid;
		justify-items: center;
		align-content: start;
		min-block-size: 100svh;
		/* The card is in the flow, so a screen too short for it grows the */
		/* section rather than clipping the synopsis. */
		padding-block: calc(var(--ring-cy) + var(--ring-r) * var(--card-at)) var(--s-6);
		overflow: clip;
	}

	/* A phone: the circle across the width, high up, with the face centred in */
	/* it, and the card lower, under the chin. */
	@media (max-aspect-ratio: 1 / 1) {
		.hero {
			--ring-cy: 35svh;
			--ring-r: 45vw;
			--face-cy: var(--ring-cy);
			--grid: 20vw;
			--card-at: 0.62;
		}
	}

	/* The castellations down each side: squares of the grid, alternately */
	/* filled, as on the Philips card every Dutch set showed before the */
	/* programmes. Narrow, so the rail stands clear of them. */
	.hero__castle {
		position: absolute;
		z-index: 1;
		inset-block: 0;
		inline-size: clamp(10px, 1.2vw, 18px);
		background: repeating-linear-gradient(
			to bottom,
			var(--castle) 0 var(--grid),
			transparent var(--grid) calc(var(--grid) * 2)
		);
		background-position-y: var(--ring-cy);
	}

	.hero__castle--start {
		inset-inline-start: 0;
	}

	.hero__castle--end {
		inset-inline-end: 0;
		background-position-y: calc(var(--ring-cy) + var(--grid));
	}

	@media (max-width: 47.99rem) {
		.hero__castle {
			display: none;
		}
	}

	/* The clock, in its box on the top of the circle, the way a card carries */
	/* the time. */
	.hero__clock {
		position: absolute;
		z-index: 2;
		inset-inline-start: 50%;
		inset-block-start: calc(var(--ring-cy) - var(--ring-r));
		translate: -50% -50%;
		padding: var(--s-1) var(--s-4);
		background: var(--field);
		border: 2px solid var(--mark);
		font-family: var(--font-mono);
		font-size: var(--t-lg);
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.06em;
		line-height: 1.3;
	}

	/* One column, centred under the face: the name in its box, then the bars */
	/* and the synopsis at the same width, so the three read as one plate. */
	/* Solid, so neither the grid nor the face ever runs behind the text. */
	.hero__card {
		position: relative;
		z-index: 2;
		display: grid;
		inline-size: min(max(34rem, var(--ring-r) * 1.1), 100% - var(--gutter) * 2);
	}

	.hero__id {
		display: grid;
		justify-items: center;
		gap: var(--s-2);
		padding: var(--s-3) var(--s-4) var(--s-4);
		background: var(--field);
		border: 2px solid var(--mark);
		border-block-end: 0;
	}

	/* One line (Rick, 2026-09-25). The svh term keeps a short laptop screen's */
	/* name from outgrowing its share of the circle. */
	.hero__id h1 {
		font-size: clamp(2.25rem, min(1rem + 4.2vw, 8.6svh), 5rem);
		line-height: 0.9;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.hero__role {
		font-family: var(--font-mono);
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--accent);
	}

	/* The colour bars: the broadcast palette, brightest to darkest, the way */
	/* the bars on a real card run. --bars is in tokens.css, with the art's */
	/* other colours. */
	.hero__bars {
		display: block;
		block-size: clamp(1rem, 3svh, 1.75rem);
		border-inline: 2px solid var(--mark);
		background: var(--bars);
	}

	.hero__lede {
		padding: var(--s-3) var(--s-4);
		background: var(--field);
		border: 2px solid var(--mark);
		border-block-start: 0;
		font-size: var(--t-sm);
		color: var(--mark-dim);
	}

	@media (min-width: 110rem) {
		.hero__lede {
			font-size: var(--t-base);
		}
	}

	/* A short screen: 1280x720 leaves 630px under the browser's own chrome, */
	/* and every section fits one screen from there; a 360x640 phone ran 13px */
	/* over at the full size. */
	@media (max-height: 760px) and (min-aspect-ratio: 1 / 1), (max-height: 700px) {
		.hero {
			--card-at: 0.3;
		}

		.hero__id {
			gap: var(--s-1);
			padding-block: var(--s-2) var(--s-3);
		}

		.hero__lede {
			padding-block: var(--s-2);
			font-size: var(--t-xs);
		}
	}

	@media (max-aspect-ratio: 1 / 1) and (max-height: 700px) {
		.hero {
			--card-at: 0.55;
		}
	}

	.lede {
		font-size: var(--t-lg);
		color: var(--mark-dim);
	}

	/* ---- How I work: a three-up horizontal grid --------------------------- */

	/* The talk, full-bleed behind the section. Positioned against .section, */
	/* which is the nearest positioned ancestor; .section--backdrop isolates it */
	/* so a z-index of -1 lands above the section's own background instead of */
	/* below it. */
	.practice__backdrop {
		position: absolute;
		inset: 0;
		z-index: -1;
		overflow: clip;
	}

	/* Oversized top and bottom: it sits back in the depth map (depth.css), and */
	/* the travel must never show an edge. */
	.practice__backdrop :global(img) {
		position: absolute;
		inset-inline: 0;
		inset-block-start: -9%;
		inline-size: 100%;
		block-size: 118%;
		object-fit: cover;
		/* Rick sits at ~18% across; on a phone this keeps him in the narrow */
		/* centre band a cover crop leaves. */
		object-position: 18% 45%;
	}

	/* Printed in ink on paper by .duo. The heading and lede sit on the top of */
	/* it, so the photograph runs out into the paper there -- lighter where the */
	/* text is, never darker. Above the overlay, or it would be printed too. */
	.practice__fade {
		position: absolute;
		inset: 0;
		z-index: 2;
		background: linear-gradient(to bottom, var(--field) 0 16%, transparent 44%);
	}

	.practice__lede {
		font-size: var(--t-lg);
		color: var(--mark-dim);
		max-width: var(--measure);
	}

	.practice {
		display: grid;
		gap: var(--s-6);
		list-style: none;
		padding: 0;
		margin-block-start: var(--s-8);
		counter-reset: none;
	}

	/* Solid plates, hard edges: the photograph shows around the cards, never */
	/* through them, so the text is always ink on paper. */
	.practice__item {
		display: grid;
		grid-template-rows: auto auto 1fr auto;
		gap: var(--s-3);
		padding: var(--s-6);
		border: 1px solid var(--mark);
		background: var(--field);
		transition: translate var(--speed) var(--ease);
	}

	.practice__item:hover,
	.practice__item:focus-within {
		translate: 0 -4px;
	}

	.practice__index {
		font-family: var(--font-mono);
		font-size: var(--t-lg);
		font-weight: 700;
		color: var(--accent);
		line-height: 1;
	}

	.practice__title {
		font-size: var(--t-xl);
		letter-spacing: var(--tracking-display);
	}

	.practice__body {
		color: var(--mark-dim);
	}

	/* The checkable detail. Set apart, because it is the thing that stops the */
	/* card being a slogan. */
	.practice__proof {
		margin-block-start: var(--s-2);
		padding-block-start: var(--s-3);
		border-block-start: 1px solid var(--line);
		font-size: var(--t-sm);
		color: var(--mark-dim);
	}

	/* Three stacked cards will always exceed a phone, and that is fine -- the */
	/* advance script scrolls an overflowing section normally before advancing. */
	/* Tightened so the overshoot is a short scroll rather than a long one. */
	@media (max-width: 51.99rem) {
		.practice {
			gap: var(--s-3);
			margin-block-start: var(--s-6);
		}

		.practice__item {
			padding: var(--s-4);
			gap: var(--s-2);
		}

		.practice__title {
			font-size: var(--t-lg);
		}

		.practice__body,
		.practice__proof {
			font-size: var(--t-sm);
		}
	}

	@media (min-width: 52rem) {
		.practice {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: var(--s-4);
		}

		.practice__item {
			padding: var(--s-4);
			gap: var(--s-2);
		}

		.practice__title {
			font-size: var(--t-lg);
		}

		.practice__body {
			font-size: var(--t-sm);
		}

		.practice__proof {
			font-size: var(--t-xs);
		}
	}

	/* Four columns, cards in the last three: the first is left clear for Rick, */
	/* so he is presenting his three points rather than hidden behind them. Only */
	/* from 76rem, because below that the cards get too narrow: 1024x768 */
	/* overran by 60px and 1152x720 by 19px. Tablets get three full-width columns over the backdrop. */
	@media (min-width: 76rem) {
		.practice {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.practice__item:first-child {
			grid-column: 2;
		}
	}

	/* A 720px-tall desktop is the shortest one in common use, and the four-column */
	/* layout overran it by 21px. Tightened only where the height is actually */
	/* short, rather than shrinking the type for every screen to pay for it. */
	@media (min-width: 76rem) and (max-height: 760px) {
		.practice {
			margin-block-start: var(--s-4);
		}

		.practice__item {
			padding: var(--s-3) var(--s-4);
		}
	}

	/* ---- Contact --------------------------------------------------------- */

	.contact {
		display: grid;
		gap: var(--s-8);
		align-items: start;
	}

	.contact__text {
		display: grid;
		gap: var(--s-8);
		max-width: var(--measure);
	}

	.contact__photo {
		position: relative;
		margin: 0;
		overflow: clip;
		border: 1px solid var(--mark);
		aspect-ratio: 4 / 5;
		/* On a phone the photo stacks under the text; at full width it pushed the */
		/* last section 104px past the screen. Supporting, not the headline. */
		/* A definite width, not a maximum. With only a maximum, the box sized */
		/* itself from the image, and a lazy image has no size until it loads: */
		/* the figure sat at 0x0, then grew to 416x520 the moment it scrolled */
		/* into view -- a layout shift at the bottom of the page, and one that */
		/* scroll anchoring answered by pulling the page 119px back up. */
		inline-size: min(16rem, 100%);
	}

	/* Oversized, because it holds back inside its frame as the frame comes */
	/* forward (depth.css): a window rather than a card. */
	.contact__photo :global(img) {
		position: absolute;
		inset-inline: 0;
		inset-block-start: -8%;
		inline-size: 100%;
		block-size: 116%;
		object-fit: cover;
		transition: filter var(--speed-slow) var(--ease-out);
	}

	/* Printed in ink on paper, and back in its own colours under the pointer, */
	/* like every other photograph on the site. */
	.contact__photo::after {
		transition: opacity var(--speed-slow) var(--ease-out);
	}

	.contact__photo:hover::after {
		opacity: 0;
	}

	.contact__photo:hover :global(img) {
		filter: none;
	}

	@media (min-width: 52rem) {
		.contact {
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		}

		/* The svh term keeps the portrait-shaped photo inside a short laptop */
		/* screen: at 26rem wide it is 520px tall, and 657px tall is common. */
		.contact__photo {
			justify-self: end;
			inline-size: min(26rem, 100%, (100svh - 13rem) * 0.8);
		}
	}
</style>
