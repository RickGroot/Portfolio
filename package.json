{
	"name": "rickgroot-portfolio",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.15.1",
	"engines": {
		"node": ">=24.16.0 <25",
		"pnpm": ">=11"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview --port 4173 --host 127.0.0.1",
		"typecheck": "astro check",
		"lint": "eslint . && prettier --check .",
		"lint:fix": "eslint . --fix && prettier --write .",
		"format": "prettier --write .",
		"test": "playwright test",
		"test:e2e": "playwright test tests/e2e",
		"test:a11y": "playwright test tests/a11y",
		"test:budget": "playwright test tests/budgets",
		"setup:browsers": "playwright install --with-deps chromium",
		"jazz": "node scripts/jazz.mjs",
		"check:assets": "node scripts/check-assets.mjs"
	},
	"dependencies": {
		"astro": "7.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/sitemap": "3.7.4",
		"@axe-core/playwright": "4.13.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.63.0",
		"eslint": "10.10.0",
		"eslint-plugin-astro": "3.2.1",
		"globals": "^16.0.0",
		"prettier": "3.9.8",
		"prettier-plugin-astro": "1.0.1",
		"sharp": "0.35.4",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0"
	}
}
