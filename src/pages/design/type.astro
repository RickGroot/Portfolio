---
import BaseLayout from '@layouts/BaseLayout.astro';

/*
 * Type candidate comparison. INTERNAL PROTOTYPE -- noindex, disallowed in
 * robots.txt and excluded from the sitemap. Delete before launch; it is
 * tracked as an open item in docs/roadmap.md.
 *
 * The brief rejects defaulting to "Inter, Space Grotesk, Sora, or another
 * predictable pairing without a specific reason", and Space Grotesk 700 was
 * what shipped. 2xA -- the closest reference of the seven -- runs exactly two
 * families: a variable monospace against plain Helvetica. So the question was
 * not "which grotesque" but "which monospace, against what".
 *
 * DECIDED 2026-09-24: Martian Mono. It now ships from public/fonts/ and is
 * declared once in typography.css; Space Grotesk is gone. The remaining
 * candidates stay for comparison until this route is deleted.
 *
 * Every candidate must be self-hostable under a licence that covers a public
 * portfolio. Redaction was the most on-concept face found (its weights ARE
 * halftone degradation levels) and is NOT listed: redaction.us grants "free
 * for personal use", which does not clearly cover a site that advertises
 * professional availability. That gap is exactly the one closed when Archive
 * Regular was dropped, and it is not worth reopening.
 */

interface Candidate {
	id: string;
	name: string;
	licence: string;
	stack: string;
	why: string;
	risk: string;
	/** Departure Mono ships a single weight; 700 would synthesise a fake bold. */
	weight?: number | undefined;
}

const candidates: Candidate[] = [
	{
		id: 'departure',
		name: 'Departure Mono',
		licence: 'SIL OFL — Helena Zhang, verified on departuremono.com',
		stack: "'Departure Mono', var(--font-mono)",
		weight: 400,
		why: 'A pixel/bitmap monospace. It IS the low-resolution signal language rather than alluding to it, and it ships full box-drawing coverage — which would lift the ASCII-only constraint on the character field ramp, because the glyphs would be guaranteed present rather than hoped for.',
		risk: 'A bitmap face at 100px display size is a strong commitment. It can read as retro-gaming rather than broadcast engineering if it is used for everything instead of headlines only.',
	},
	{
		id: 'martian',
		name: 'Martian Mono (chosen)',
		licence: 'SIL OFL — Roman Shamin / Evil Martians — ships from fonts/, metric-matched',
		stack: "'Martian Mono', var(--font-mono)",
		why: 'Deliberately brutal and wide, drawn for display rather than for code comfort. It has a sibling grotesque (Martian Grotesk), so display and text could come from one designed system instead of two unrelated families.',
		risk: 'Wide advance widths mean long titles eat horizontal space fast: every glyph is 0.7em, so CHROMECAST needs 6.8em at the display tracking and the titles are set to 14cqi to hold it.',
	},
	{
		id: 'archivo',
		name: 'Archivo Expanded 800',
		licence: 'SIL OFL — Omnibus-Type, via Google Fonts',
		stack: "'Archivo Expanded', var(--font-sans)",
		why: 'A grotesque drawn with a real width axis, set here at 125. Wide and heavy without being a novelty, which is the classic editorial-poster register — big, flat, unfussy.',
		risk: 'It is a Google Fonts workhorse. Distinctive at this width, but it will not surprise anyone, which is exactly the objection the brief raised against Space Grotesk.',
		weight: 800,
	},
	{
		id: 'unbounded',
		name: 'Unbounded 800',
		licence: 'SIL OFL — via Google Fonts',
		stack: "'Unbounded', var(--font-sans)",
		why: 'Geometric, very wide, and unusual enough to be recognisable on its own. Holds together at enormous sizes, which is where a panel title actually lives.',
		risk: 'The geometric roundness argues with the hard pixel grid of the character field. Two different ideas of what a shape is.',
		weight: 800,
	},
	{
		id: 'syne',
		name: 'Syne 800',
		licence: 'SIL OFL — Bonjour Monde / Lucas Descroix',
		stack: "'Syne', var(--font-sans)",
		why: 'Deliberately odd proportions from a type foundry that works with art institutions. The most authored of the five — nobody reaches for this by default.',
		risk: 'Strong enough personality to become the site’s whole voice, and it reads art-gallery rather than broadcast engineering.',
		weight: 800,
	},
	{
		id: 'orbitron',
		name: 'Orbitron 900',
		licence: 'SIL OFL — Matt McInerney',
		stack: "'Orbitron', var(--font-sans)",
		why: 'Squared geometry drawn specifically for display sizes. The closest of the five to on-screen broadcast and device UI, which is literally the subject matter.',
		risk: 'It is the sci-fi default. Very easy to read as a 2010s technology cliché rather than as a considered choice.',
		weight: 900,
	},
];

const specimens = ['NLZIET', 'CHROMECAST', 'VAMP'];
---

<BaseLayout title="Type candidates" noindex={true}>
	<div class="proto">
		<header class="proto__head">
			<p class="proto__flag">Internal prototype — noindex, not for launch</p>
			<h1>Type candidates</h1>
			<p class="proto__note">
				Martian Mono was chosen and ships site-wide. The others are self-hosted here from
				<code>fonts/proto/</code>, which is served only to this route and must be empty before
				launch.
			</p>
		</header>

		{candidates.map((c) => (
			<section class="cand">
				<div class="cand__meta">
					<h2>{c.name}</h2>
					<p class="cand__licence">{c.licence}</p>
				</div>

				<div
					class="cand__specimens"
					data-specimens
					style={`--stack:${c.stack}; --stack-weight:${c.weight ?? 700}`}
				>
					{specimens.map((s) => (
						<p class="cand__display">{s}</p>
					))}
					<p class="cand__meta-line">02 / CONNECTED TV DEVELOPER / TRIPLE / ONGOING SINCE 2023</p>
				</div>

				<p class="cand__metric" data-metric></p>

				<dl class="cand__notes">
					<dt>Why</dt>
					<dd>{c.why}</dd>
					<dt>Risk</dt>
					<dd>{c.risk}</dd>
				</dl>
			</section>
		))}
	</div>
</BaseLayout>

<script>
	/*
	 * Measure, rather than eyeball. "CHROMECAST" is the longest word in the
	 * content and the constraint on every panel title, so the useful number for
	 * each face is how many ems it needs. Martian Mono needs 6.8em; a face
	 * needing materially more will break mid-word at the same size, which is
	 * what the reset's overflow-wrap does to a display heading.
	 *
	 * Internal prototype page only. Nothing here ships.
	 */
	// MUST wait for the webfonts. These are font-display: swap and load async,
	// so measuring at parse time silently measures the fallback -- which gave
	// four different faces an identical 6.61em, the exact signature of a
	// fallback reading rather than a real one.
	await document.fonts.ready;

	const LONGEST = 'CHROMECAST';
	for (const box of document.querySelectorAll('[data-specimens]')) {
		const sample = box.querySelector('p');
		if (!(sample instanceof HTMLElement)) continue;
		const cs = getComputedStyle(sample);
		const probe = document.createElement('span');
		probe.style.cssText =
			'position:absolute;visibility:hidden;white-space:nowrap;font-size:100px;' +
			`font-family:${cs.fontFamily};font-weight:${cs.fontWeight};` +
			`letter-spacing:${cs.letterSpacing};text-transform:${cs.textTransform};`;
		probe.textContent = LONGEST;
		document.body.append(probe);
		const em = probe.getBoundingClientRect().width / 100;
		probe.remove();

		// At `font-size: Ncqi` the longest word fits when em * N/100 <= 1, so the
		// largest usable N is 100/em. The panels currently use 14cqi. A wide face
		// is not disqualified by this -- it just has to be set smaller.
		const maxCqi = 100 / em;
		const fits = maxCqi >= 14;
		const out = box.parentElement?.querySelector('[data-metric]');
		if (out instanceof HTMLElement) {
			out.textContent =
				`${LONGEST} = ${em.toFixed(2)}em — fits up to ${maxCqi.toFixed(1)}cqi` +
				(fits ? ' (panels use 14)' : ' — below the 14cqi the panels use');
			out.dataset.fits = String(fits);
		}
	}
</script>

<style is:global>
	/*
		 * Candidate faces, served ONLY to this internal route from fonts/proto/.
		 * They are excluded from the production font budget on purpose and
		 * check-assets warns on every run until the directory is empty.
		 */
	@font-face {
		font-family: 'Departure Mono';
		src: url('/fonts/proto/departure-mono.woff2') format('woff2');
		font-weight: 400;
		font-display: swap;
	}

	@font-face {
		font-family: 'Archivo Expanded';
		src: url('/fonts/proto/archivo-exp-800.woff2') format('woff2');
		font-weight: 800;
		font-display: swap;
	}
	@font-face {
		font-family: 'Unbounded';
		src: url('/fonts/proto/unbounded-800.woff2') format('woff2');
		font-weight: 800;
		font-display: swap;
	}
	@font-face {
		font-family: 'Syne';
		src: url('/fonts/proto/syne-800.woff2') format('woff2');
		font-weight: 800;
		font-display: swap;
	}
	@font-face {
		font-family: 'Orbitron';
		src: url('/fonts/proto/orbitron-900.woff2') format('woff2');
		font-weight: 900;
		font-display: swap;
	}
</style>

<style>
	.proto {
		display: grid;
		gap: var(--s-16);
		padding-block: var(--s-12) var(--s-24);
	}

	.proto__flag {
		font-family: var(--font-mono);
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--accent);
	}

	.proto__head {
		display: grid;
		gap: var(--s-3);
	}

	.proto__note {
		max-width: var(--measure);
		color: var(--mark-dim);
	}

	.cand {
		display: grid;
		gap: var(--s-6);
		padding-block-start: var(--s-8);
		border-block-start: 1px solid var(--line);
	}

	.cand__licence {
		font-family: var(--font-mono);
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--mark-dim);
	}

	/* Sized the way the panels size it, so this is a fair comparison and not a
	   specimen poster: container-relative, capped, uppercase, tight. */
	.cand__specimens {
		container-type: inline-size;
	}

	.cand__display {
		font-family: var(--stack);
		font-weight: var(--stack-weight);
		font-size: min(clamp(2.75rem, 1rem + 7vw, 7rem), 14cqi);
		line-height: 0.92;
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
	}

	.cand__meta-line {
		margin-block-start: var(--s-4);
		font-family: var(--stack);
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--mark-dim);
	}

	.cand__metric {
		font-family: var(--font-mono);
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--accent);
	}

	.cand__notes {
		display: grid;
		grid-template-columns: max-content minmax(0, var(--measure));
		gap: var(--s-2) var(--s-6);
		align-items: baseline;
	}

	.cand__notes dt {
		font-family: var(--font-mono);
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--mark-dim);
	}

	.cand__notes dd {
		margin: 0;
		color: var(--mark-dim);
	}
</style>
