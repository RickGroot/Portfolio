	/* ---- first sight: the guide draws itself ------------------------------- */

	/* Each programme runs out along its row, one row after another, the first */
	/* time the guide comes on screen -- a guide loading its listings. Keyed off */
	/* an attribute guide.ts sets, so without JavaScript nothing waits on it, */
	/* and a time-based animation rather than a scroll-driven one: tied to the */
	/* scroll, the rows at the bottom of the screen never finished drawing. */
	@media (prefers-reduced-motion: no-preference) {
		.guide[data-drawing] .guide__block,
