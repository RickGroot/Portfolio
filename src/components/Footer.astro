---
import SocialLinks from './SocialLinks.astro';
import { channelStyle } from '@lib/channels';
const year = new Date().getFullYear();
---

{/* Always paper: the end of every page is the same quiet channel, whatever */}
{/* the page above it was broadcasting. */}
<footer data-channel="paper" style={channelStyle('paper')}>
	<div class="wrap inner">
		<p class="cta">
			<a href="mailto:RickGroot41@gmail.com">Email me.</a>
		</p>
		<SocialLinks />
		<p class="fine">&copy; {year} Rick Groot</p>
	</div>
</footer>

<style>
	/* Padding, not a margin: a margin would open a strip of the page's own */
	/* channel between the last section and this one. */
	footer {
		border-top: 1px solid var(--line);
		padding-block: var(--s-12);
	}
	.inner {
		display: flex;
		flex-direction: column;
		gap: var(--s-6);
	}
	.cta {
		font-size: var(--t-lg);
	}
	.fine {
		color: var(--mark-dim);
		font-size: var(--t-sm);
	}
</style>
