{
	"extends": "astro/tsconfigs/strictest",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist", "node_modules", "test-results", "playwright-report"],
	"compilerOptions": {
		"verbatimModuleSyntax": true,
		"paths": {
			"@components/*": ["./src/components/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@styles/*": ["./src/styles/*"],
			"@lib/*": ["./src/lib/*"],
			"@scripts/*": ["./src/scripts/*"],
			"@assets/*": ["./src/assets/*"]
		}
	}
}
