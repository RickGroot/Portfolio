---
interface Props {
	tags: readonly string[];
	label?: string | undefined;
}
const { tags, label = 'Technologies' } = Astro.props;
---

<ul class="tags" aria-label={label}>
	{tags.map((t) => (
		<li>{t}</li>
	))}
</ul>

<style>
	/* A line of monospace, not a row of pills: hard edges everywhere, and a */
	/* tag is a label, not a control, so it should not look like a button. */
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-1) 0;
		list-style: none;
		margin: 0;
		padding: 0;
		font-family: var(--font-mono);
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--mark-dim);
	}

	/* The separator is decoration: the empty alternative text keeps screen */
	/* readers from announcing "slash" between every item. Browsers without */
	/* the alt syntax drop the second declaration and keep the first. After */
	/* the item rather than before the next, so a wrapped line ends on a */
	/* slash instead of starting with one. */
	li:not(:last-child)::after {
		content: '/';
		content: '/' / '';
		padding-inline: 0.75em;
	}
</style>
