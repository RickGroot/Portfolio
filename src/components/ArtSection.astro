---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { channelStyle, type Channel } from '@lib/channels';

interface Props {
	id: string;
	image: ImageMetadata;
	alt: string;
	statement: string;
	caption: string;
	/** The channel the interlude is broadcast on. Its field and mark print the photograph. */
	channel: Channel;
	/**
	 * The object-position that keeps the subject in frame. A full-bleed cover
	 * image on a phone shows a narrow centre band of a landscape photograph, so
	 * a subject that is off-centre -- the clock tower -- gets cut away unless the
	 * crop is told where to look.
	 */
	focus?: string | undefined;
	/**
	 * Brightness before the print (surfaces.css --duo-lift). A photograph that
	 * is mostly mid-tones prints muddy on a multiply channel; lifting it sends
	 * those mid-tones to the field.
	 */
	lift?: number | undefined;
	/** How hard the two colours separate (surfaces.css --duo-contrast). */
	contrast?: number | undefined;
}

const {
	id,
	image,
	alt,
	statement,
	caption,
	channel,
	focus = '50% 50%',
	lift,
	contrast,
} = Astro.props;

// "Interlude / Signal" names the channel "Signal": on the readout, and in the
// heading, so the two interludes are two regions rather than one twice.
const name = caption.split('/').pop()?.trim() ?? caption;

const levels = [
	lift === undefined ? '' : `--duo-lift:${lift}`,
	contrast === undefined ? '' : `--duo-contrast:${contrast}`,
]
	.filter(Boolean)
	.join(';');
---

<section
	id={id}
	class="art"
	aria-labelledby={`${id}-heading`}
	data-section
	data-channel={channel}
	data-osd={name}
	style={`${channelStyle(channel)};--art-focus:${focus}`}
>
	<h2 id={`${id}-heading`} class="visually-hidden">
		Interlude: {name}
	</h2>

	<div class="art__media duo" data-dither style={levels || undefined}>
		<Image
			src={image}
			alt={alt}
			widths={[800, 1200, 1600]}
			sizes="100vw"
			loading="lazy"
			decoding="async"
		/>
		<span class="art__fade" data-fade aria-hidden="true"></span>
	</div>

	<div class="art__copy wrap">
		<p class="art__statement" data-decode>
			<span class="art__plate">{statement}</span>
		</p>
		<p class="art__caption">{caption}</p>
	</div>
</section>

<style>
	/* An interlude: no navigation, no links, nothing to do. It exists to give */
	/* the narrative a breath between projects, which is the one thing a */
	/* wall-to-wall sequence of case studies cannot do for itself. */
	.art {
		position: relative;
		min-block-size: 100svh;
		display: grid;
		align-content: end;
		overflow: clip;
		padding-block-end: var(--s-24);
		isolation: isolate;
	}

	.art__media {
		position: absolute;
		inset: 0;
		z-index: -1;
		overflow: clip;
		/* The fade below, as the 1-bit print dithers it (surfaces.css): it */
		/* lands sooner than the gradient, at 80% rather than 92%, because a */
		/* stray dot behind the small caption is noise where 8% of a gradient */
		/* was not. The caption starts about 85% down a 720px screen, and */
		/* tests/e2e/dither.spec.ts holds it to clean field. */
		--dither-fade: 0.4 0.8;
	}

	/* Printed in the channel's two colours by .duo (surfaces.css), at full */
	/* strength: the photograph IS the section, not a texture behind it. The */
	/* canvas is the same print in one bit, in the same box. */
	.art__media :global(img),
	.art__media :global(canvas) {
		position: absolute;
		inset-inline: 0;
		inset-block-start: -12%;
		inline-size: 100%;
		block-size: 124%;
		object-fit: cover;
		object-position: var(--art-focus);
	}

	/* Its parallax -- deeper than anything else on the page, so an interlude */
	/* sits further back -- is in the depth map, src/styles/depth.css. The */
	/* picture is oversized above so the travel never shows an edge. */

	/* The statement sits on the bottom of the photograph, so the photograph */
	/* runs out into the field there. The field, not a darker shade: on the */
	/* yellow channel this is yellow. Above the overlay, or it would be printed */
	/* into the duotone with everything else. */
	.art__fade {
		position: absolute;
		inset: 0;
		z-index: 2;
		background: linear-gradient(to bottom, transparent 45%, var(--field) 92%);
	}

	.art__copy {
		position: relative;
		display: grid;
		gap: var(--s-4);
		max-width: var(--measure);
	}

	.art__statement {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(1.75rem, 0.9rem + 3.2vw, 3.25rem);
		/* Not the display's usual 1.08: at 1.16 the lines' plates can meet */
		/* without one painting over the descenders above it. */
		line-height: 1.16;
		letter-spacing: var(--tracking-display);
		text-wrap: balance;
	}

	/* On a plate of the field, line by line. The statement crosses the */
	/* photograph -- the lighthouse's tower, at most sizes -- and text never */
	/* sits on a picture bare. On the field the plate cannot be seen; it only */
	/* shows where the picture is dark, as a band of the channel's colour. */
	/* Bricolage's line box is 1.2em (0.93 up, 0.27 down), its capitals stand */
	/* 0.66em and its descenders reach 0.17em. Each plate runs from 0.81em above */
	/* its baseline to 0.36em below: the background leaves off the top 0.12em, */
	/* so the band sits evenly around the letters, and the padding takes the */
	/* bottom down to meet the next plate. At the 1.16 pitch that one starts */
	/* 0.35em below this baseline -- over it by a hair, no seam, and clear of */
	/* this line's descenders, which it would otherwise paint over. */
	.art__plate {
		padding: 0 0.12em 0.09em;
		margin-inline: -0.12em;
		background: linear-gradient(var(--field), var(--field)) bottom / 100% calc(100% - 0.12em)
			no-repeat;
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
	}

	.art__caption {
		font-family: var(--font-mono);
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--accent);
	}
</style>
