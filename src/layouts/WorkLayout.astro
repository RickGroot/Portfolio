---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Guide from '@components/Guide.astro';
import { formatPeriod, getPublishedWork, type PublishedWorkEntry } from '@lib/work';
import { channelStyle, coverPrint } from '@lib/channels';
import { vt } from '@lib/vt';

/**
 * A case study, as the programme-information screen of the guide it came from.
 *
 * Same channel, same picture, same title -- the view transition carries the
 * guide's preview straight into this page -- and the guide itself runs along
 * the bottom with this programme lit, so moving to the next piece of work is
 * changing channel rather than going back to a list. There is no site header;
 * the way out is the Guide button, or Escape, like the Back key on a remote.
 */
interface Props {
	entry: PublishedWorkEntry;
	index: string;
	prev?: PublishedWorkEntry | undefined;
	next?: PublishedWorkEntry | undefined;
}

const { entry, index, prev, next } = Astro.props;
const { title, role, company, summary, tags, channel, cover, coverAlt, coverTone, links, status } =
	entry.data;
const all = await getPublishedWork();
const lastYear = entry.data.period.split('–').pop();
const numberOf = (e: PublishedWorkEntry): string =>
	String(all.findIndex((w) => w.id === e.id) + 1).padStart(2, '0');
---

<BaseLayout title={title} description={summary} channel={channel} bleed>
	<article class="info" data-channel={channel} style={channelStyle(channel)}>
		<div class="info__chrome wrap">
			<a class="info__back" href="/#work" data-back>
				<span aria-hidden="true">←</span> Guide
				<span class="keyhint" aria-hidden="true">
					Esc
				</span>
			</a>
			<p class="info__osd" aria-hidden="true">
				CH {index} <b>{title.split(' ')[0]}</b>
			</p>
		</div>

		<header class="info__head wrap">
			<div
				class="info__screen duo"
				style={`view-transition-name:${vt('cover', entry.id)};${coverPrint(channel, coverTone) ?? ''}`}
			>
				<Image
					src={cover}
					alt={coverAlt}
					widths={[800, 1280, 1920]}
					sizes="(min-width: 64rem) 56vw, 100vw"
					loading="eager"
					fetchpriority="high"
				/>
			</div>

			<div class="info__titles">
				<p class="info__status">
					{status === 'ongoing' ? (
						<span class="onair onair--live">On air</span>
					) : (
						<span class="onair onair--ended">Ended {lastYear}</span>
					)}
				</p>
				<div class="info__titlebox">
					<h1 class="info__title" style={`view-transition-name:${vt('title', entry.id)}`}>
						{title}
					</h1>
				</div>
				<p class="info__lede">{summary}</p>
				{links.length > 0 && (
					<ul class="info__actions">
						{links.map((l, i) => (
							<li>
								<a
									class:list={['tvbtn', { 'tvbtn--solid': i === 0 }]}
									href={l.href}
									target="_blank"
									rel="noopener noreferrer"
								>
									{l.label}
									<span aria-hidden="true">↗</span>
									<span class="visually-hidden">(opens in a new tab)</span>
								</a>
							</li>
						))}
					</ul>
				)}
			</div>
		</header>

		<div class="info__main wrap">
			{/* The labelled key/value block, 2xA-style: facts, not prose. */}
			<dl class="info__facts">
				<div>
					<dt>Channel</dt>
					<dd>{index}</dd>
				</div>
				<div>
					<dt>Role</dt>
					<dd>{role}</dd>
				</div>
				<div>
					<dt>Company</dt>
					<dd>{company}</dd>
				</div>
				<div>
					<dt>On air</dt>
					<dd>{formatPeriod(entry)}</dd>
				</div>
				<div>
					<dt>Stack</dt>
					<dd>{tags.join(' / ')}</dd>
				</div>
			</dl>

			<div class="info__body prose">
				<slot />
			</div>
		</div>

		{(prev || next) && (
			<nav class="info__zap wrap" aria-label="Other programmes">
				{prev && (
					<a class="info__step" href={`/work/${prev.id}`} rel="prev">
						<span class="info__plate" style={channelStyle(prev.data.channel)}>
							<span class="info__steplabel">
								<span aria-hidden="true">◂</span> CH {numberOf(prev)}
							</span>
							<span class="info__steptitle">{prev.data.title}</span>
						</span>
					</a>
				)}
				{next && (
					<a class="info__step info__step--next" href={`/work/${next.id}`} rel="next">
						<span class="info__plate" style={channelStyle(next.data.channel)}>
							<span class="info__steplabel">
								CH {numberOf(next)} <span aria-hidden="true">▸</span>
							</span>
							<span class="info__steptitle">{next.data.title}</span>
						</span>
					</a>
				)}
			</nav>
		)}

		<div class="info__guide">
			<Guide entries={all} form="strip" current={entry.id} />
		</div>
	</article>
</BaseLayout>

<script>
	import { decode } from '../lib/decode';

	// The title tunes in as the page arrives -- once the display face is in, so
	// the noise glyphs are the same width as the letters.
	void document.fonts.ready.then(() => decode(document.querySelector<HTMLElement>('.info__title')));

	/*
	 * Escape and Backspace go back to the guide, like the Back key on a remote.
	 * Straight back through history when the visitor came from the one-pager,
	 * so the guide is where they left it; otherwise to the guide itself.
	 * Never while typing, and never when something else already took the key.
	 */
	const back = document.querySelector<HTMLAnchorElement>('[data-back]');

	function cameFromGuide(): boolean {
		if (!document.referrer) return false;
		const ref = new URL(document.referrer);
		return ref.origin === location.origin && ref.pathname === '/' && history.length > 1;
	}

	if (back) {
		back.addEventListener('click', (ev) => {
			if (!cameFromGuide()) return;
			ev.preventDefault();
			history.back();
		});

		window.addEventListener('keydown', (ev) => {
			if (ev.key !== 'Escape' && ev.key !== 'Backspace') return;
			if (ev.defaultPrevented || ev.metaKey || ev.ctrlKey || ev.altKey) return;
			const el = ev.target as HTMLElement | null;
			if (el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName))) return;
			ev.preventDefault();
			if (cameFromGuide()) history.back();
			else location.assign(back.href);
		});
	}
</script>

<style>
	/* ---- the screen ------------------------------------------------------- */

	/* Full bleed, so the channel's ground runs edge to edge; children re-wrap. */
	.info {
		padding-block: var(--s-6) 0;
	}

	/* ---- chrome: the way back, and where you are --------------------------- */

	.info__chrome {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--s-4);
		min-block-size: 3rem;
	}

	/* App chrome, not a header: pinned to the corner of the screen, on a plate */
	/* of the channel so it stays legible over the picture as the page scrolls. */
	.info__back {
		position: fixed;
		z-index: var(--z-nav);
		inset-block-start: var(--s-4);
		inset-inline-start: var(--s-4);
		display: inline-flex;
		align-items: center;
		gap: var(--s-3);
		min-block-size: 44px;
		padding-inline: var(--s-4);
		background: var(--field);
		border: 2px solid var(--mark);
		color: var(--mark);
		font-family: var(--font-mono);
		font-size: var(--t-sm);
		font-weight: 700;
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		text-decoration: none;
		transition:
			background-color var(--speed) var(--ease),
			color var(--speed) var(--ease);
	}

	.info__back:hover,
	.info__back:focus-visible {
		background: var(--mark);
		color: var(--field);
	}

	.info__osd {
		margin-inline-start: auto;
		font-family: var(--font-display);
		font-size: var(--t-lg);
		letter-spacing: 0.04em;
		color: var(--mark);
	}

	.info__osd b {
		margin-inline-start: 0.5em;
		color: var(--accent);
		text-transform: uppercase;
	}

	/* ---- head: the picture, and what it is --------------------------------- */

	.info__head {
		display: grid;
		gap: var(--s-6);
		margin-block-start: var(--s-6);
	}

	.info__screen {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: clip;
		border: 2px solid var(--accent);
	}

	/* Oversized top and bottom, so it can drift inside its frame. */
	.info__screen :global(img) {
		position: absolute;
		inset-inline: 0;
		inset-block-start: -6%;
		inline-size: 100%;
		block-size: 112%;
		object-fit: cover;
		transition: filter var(--speed-slow) var(--ease-out);
	}

	@media (prefers-reduced-motion: no-preference) {
		.info__screen :global(img) {
			animation: info-push 24s ease-in-out infinite alternate;
		}

		/* Parallax, on the page's own scroll: the head leaves in layers -- the */
		/* picture sinks, the title lifts -- the picture drifts inside its frame */
		/* the whole time it is on screen, and the guide rises into place as it */
		/* arrives. Every range starts at rest, so the page loads exactly as laid */
		/* out. Transform only; no script. */
		@supports (animation-timeline: view()) {
			.info__screen :global(img) {
				animation:
					info-push 24s ease-in-out infinite alternate,
					info-drift linear both;
				animation-timeline: auto, view();
				animation-range:
					normal,
					cover 0% cover 100%;
			}

			.info__screen {
				animation: info-sink linear both;
				animation-timeline: view();
				animation-range: exit 0% exit 100%;
			}

			.info__titles {
				animation: info-lift linear both;
				animation-timeline: view();
				animation-range: exit 0% exit 100%;
			}

			.info__zap,
			.info__guide {
				animation: info-arrive linear both;
				animation-timeline: view();
				animation-range: entry 0% entry 90%;
			}
		}
	}

	@keyframes info-drift {
		from {
			transform: translateY(-4%);
		}
		to {
			transform: translateY(4%);
		}
	}

	@keyframes info-sink {
		to {
			transform: translateY(16vh);
		}
	}

	@keyframes info-lift {
		to {
			transform: translateY(-9vh);
		}
	}

	/* Transform only: fading the strip in would leave it half-transparent, */
	/* and half-transparent text is text below its contrast floor. */
	@keyframes info-arrive {
		from {
			transform: translateY(12vh);
		}
	}

	@keyframes info-push {
		from {
			scale: 1.02;
		}
		to {
			scale: 1.1;
			translate: -1.5% -1%;
		}
	}

	.info__screen::before,
	.info__screen::after {
		transition: opacity var(--speed-slow) var(--ease-out);
	}

	.info__screen:hover::before,
	.info__screen:hover::after {
		opacity: 0;
	}

	.info__screen:hover :global(img) {
		filter: none;
	}

	.info__titles {
		display: grid;
		align-content: end;
		justify-items: start;
		gap: var(--s-4);
		min-inline-size: 0;
	}

	.info__titlebox {
		inline-size: 100%;
		container-type: inline-size;
	}

	/* 14cqi: CHROMECAST is 6.8em in Martian Mono at the display tracking. */
	.info__title {
		font-size: min(clamp(2.75rem, 1rem + 6vw, 7rem), 14cqi);
		line-height: 0.88;
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
	}

	.info__lede {
		max-inline-size: 40rem;
		font-size: var(--t-lg);
		line-height: 1.45;
		text-wrap: pretty;
	}

	.info__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-4);
		list-style: none;
		padding: 0;
		margin-block-start: var(--s-2);
	}

	/* ---- main: the facts, and the story ------------------------------------ */

	.info__main {
		display: grid;
		gap: var(--s-8);
		margin-block-start: var(--s-12);
		padding-block-start: var(--s-8);
		border-block-start: 1px solid var(--line);
	}

	.info__facts {
		display: grid;
		gap: var(--s-3);
		align-content: start;
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--t-sm);
	}

	.info__facts div {
		display: grid;
		grid-template-columns: 6.5rem minmax(0, 1fr);
		gap: var(--s-3);
		padding-block-end: var(--s-3);
		border-block-end: 1px solid var(--line);
	}

	.info__facts dt {
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--accent);
		padding-block-start: 0.15em;
	}

	.info__facts dd {
		margin: 0;
		color: var(--mark);
	}

	.info__body {
		font-size: var(--t-base);
		line-height: 1.7;
	}

	.info__body :global(strong) {
		color: var(--accent);
		font-weight: 700;
	}

	.info__body :global(a) {
		color: var(--accent);
	}

	/* ---- zap: channel down, channel up ------------------------------------- */

	.info__zap {
		display: grid;
		gap: var(--s-4);
		margin-block-start: var(--s-16);
	}

	/* The colours sit on an inner plate, not on the link, so the link's focus */
	/* ring stays in this page's mark -- a ring in the destination's colours */
	/* could vanish against this ground. */
	.info__step {
		display: grid;
		text-decoration: none;
		transition: scale var(--speed) var(--ease);
	}

	.info__step:hover,
	.info__step:focus-visible {
		scale: 1.02;
	}

	.info__plate {
		display: grid;
		gap: var(--s-2);
		padding: var(--s-4) var(--s-6);
		background: var(--field);
		color: var(--mark);
		border: 2px solid var(--accent);
	}

	.info__steplabel {
		font-family: var(--font-mono);
		font-size: var(--t-xs);
		font-weight: 700;
		letter-spacing: var(--tracking-meta);
		color: var(--accent);
	}

	.info__steptitle {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--t-xl);
		line-height: 1;
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
	}

	.info__step--next {
		text-align: end;
	}

	.info__step--next .info__plate {
		justify-items: end;
	}

	/* ---- the guide, along the bottom --------------------------------------- */

	.info__guide {
		margin-block-start: var(--s-12);
		padding-block: var(--s-8) var(--s-12);
		border-block-start: 1px solid var(--line);
	}

	/* ---- wide screens ------------------------------------------------------- */

	@media (min-width: 48rem) {
		.info__zap {
			grid-template-columns: 1fr 1fr;
		}

		/* A lone "next" belongs on the right, where next always is. */
		.info__step--next:only-child {
			grid-column: 2;
		}
	}

	@media (min-width: 64rem) {
		.info__head {
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
			gap: var(--s-12);
			align-items: end;
		}

		.info__main {
			grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
			gap: var(--s-16);
		}

		/* The facts stay beside the story as it scrolls. */
		.info__facts {
			position: sticky;
			inset-block-start: var(--s-24);
		}
	}
</style>
