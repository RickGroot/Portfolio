---
import BaseLayout from '@layouts/BaseLayout.astro';
import CharacterField from '@components/CharacterField.astro';
import WorkCard from '@components/WorkCard.astro';
import TagList from '@components/TagList.astro';
import SocialLinks from '@components/SocialLinks.astro';
import { getFeaturedWork } from '@lib/work';
import { skills } from '@lib/skills';
import { site } from '@lib/site';

const featured = await getFeaturedWork();
---

<BaseLayout title={site.name} description={site.description}>
	<section class="hero">
		<CharacterField />
		<div class="hero__copy">
			<h1>Rick Groot</h1>
			<p class="lede">
				I build Connected TV experiences — Smart TV apps, Chromecast receivers and video players
				that have to run well on hardware you do not get to choose.
			</p>
			<TagList tags={skills} label="What I work on" />
		</div>
	</section>

	<section aria-labelledby="featured-heading" class="featured">
		<h2 id="featured-heading">Selected work</h2>
		<div class="list">
			{featured.map((entry) => (
				<WorkCard entry={entry} as="h3" />
			))}
		</div>
		<p>
			<a href="/work">All work →</a>
		</p>
	</section>

	<section aria-labelledby="contact-heading" class="contact">
		<h2 id="contact-heading">Contact</h2>
		<p>Feel free to reach out.</p>
		<SocialLinks />
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		display: grid;
		align-items: center;
		min-block-size: var(--hero-min);
		padding-block: var(--s-16) var(--s-24);
		/* The field is absolutely positioned inside and bleeds past the wrap, */
		/* so the hero owns the full width of the viewport. */
		margin-inline: calc(50% - 50vw);
		padding-inline: var(--gutter);
	}

	/* Scrim so the heading stays legible over the field. A static gradient, */
	/* painted once -- never animated. */
	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background:
			linear-gradient(
				100deg,
				var(--c-bg) 0 38%,
				color-mix(in oklab, var(--c-bg) 55%, transparent) 58%,
				transparent 78%
			),
			linear-gradient(to bottom, var(--c-bg), transparent 18%, transparent 82%, var(--c-bg));
	}

	.hero__copy {
		position: relative;
		z-index: 2;
		display: grid;
		gap: var(--s-6);
		max-width: var(--measure);
		width: min(100% - var(--gutter) * 2, var(--wrap));
		margin-inline: auto;
	}

	.hero__copy h1 {
		font-size: var(--t-3xl);
		letter-spacing: var(--tracking-display);
	}

	.lede {
		font-size: var(--t-lg);
		color: var(--c-text-dim);
	}

	.featured,
	.contact {
		display: grid;
		gap: var(--s-8);
		padding-block-end: var(--s-16);
	}

	.list {
		display: grid;
		gap: var(--s-12);
	}
</style>
