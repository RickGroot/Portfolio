---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import TagList from '@components/TagList.astro';
import { formatPeriod, type PublishedWorkEntry } from '@lib/work';
import { channelStyle, NEGATIVE_PRINT } from '@lib/channels';
import { vt } from '@lib/vt';

interface Props {
	entry: PublishedWorkEntry;
	index: string;
	prev?: PublishedWorkEntry | undefined;
	next?: PublishedWorkEntry | undefined;
}

const { entry, index, prev, next } = Astro.props;
const { title, role, company, summary, tags, channel, cover, coverAlt, coverInvert, links } =
	entry.data;
---

{/* Two channels: the entry's own for the page and its hero -- the same field */}
{/* its panel carries on the one-pager, so the cover lands in the colour it */}
{/* left -- and paper for the reading, where the long text gets 16.65:1. */}
<BaseLayout title={title} description={summary} channel={channel}>
	<article class="case">
		<header class="case__hero" data-channel={channel} style={channelStyle(channel)}>
			<div class="case__media" style={`view-transition-name:${vt('cover', entry.id)}`}>
				<span class="case__frame duo" style={coverInvert ? NEGATIVE_PRINT : undefined}>
					<Image
						src={cover}
						alt={coverAlt}
						widths={[900, 1600, 2400]}
						sizes="100vw"
						loading="eager"
						fetchpriority="high"
					/>
				</span>
				<span class="case__bracket case__bracket--tl" aria-hidden="true"></span>
				<span class="case__bracket case__bracket--tr" aria-hidden="true"></span>
				<span class="case__bracket case__bracket--bl" aria-hidden="true"></span>
				<span class="case__bracket case__bracket--br" aria-hidden="true"></span>
			</div>

			<div class="case__headline wrap">
				<p class="case__meta">
					<span class="case__index" aria-hidden="true">
						{index}
					</span>
					<span class="case__bars" aria-hidden="true">
						<i></i>
						<i></i>
						<i></i>
						<i></i>
					</span>
					<span>{role}</span>
					<span class="case__sep" aria-hidden="true">
						/
					</span>
					<span>{company}</span>
					<span class="case__sep" aria-hidden="true">
						/
					</span>
					<span>{formatPeriod(entry)}</span>
				</p>
				<div class="case__titlebox">
					<h1 class="case__title" style={`view-transition-name:${vt('title', entry.id)}`}>
						<span class="case__plate">{title}</span>
					</h1>
				</div>
			</div>
		</header>

		<div class="case__reading" data-channel="paper" style={channelStyle('paper')}>
			<div class="case__body wrap">
				<p class="case__lede" data-reveal>
					{summary}
				</p>
				<div data-reveal>
					<TagList tags={tags} />
				</div>

				<div class="prose" data-reveal>
					<slot />
				</div>

				{links.length > 0 && (
					<div class="case__links" data-reveal>
						<h2 class="visually-hidden">Project links</h2>
						<ul>
							{links.map((l) => (
								<li>
									<a href={l.href} target="_blank" rel="noopener noreferrer">
										{l.label}
										<span aria-hidden="true"> ↗</span>
										<span class="visually-hidden"> (opens in a new tab)</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				)}
			</div>

			<nav class="case__nav wrap" aria-label="Work">
				<a class="case__back" href={`/#${entry.id}`}>
					<span aria-hidden="true">←</span> Back to the overview
				</a>
				<div class="case__sequence">
					{prev && (
						<a class="case__step" href={`/work/${prev.id}`} rel="prev">
							<span class="case__stepplate" style={channelStyle(prev.data.channel)}>
								<span class="case__steplabel">Previous</span>
								<span class="case__steptitle">{prev.data.title}</span>
							</span>
						</a>
					)}
					{next && (
						<a class="case__step case__step--next" href={`/work/${next.id}`} rel="next">
							<span class="case__stepplate" style={channelStyle(next.data.channel)}>
								<span class="case__steplabel">Next</span>
								<span class="case__steptitle">{next.data.title}</span>
							</span>
						</a>
					)}
				</div>
			</nav>
		</div>
	</article>
</BaseLayout>

<style>
	/* ---- the hero: the same treatment as a panel, at full width ---------- */

	/* The same treatment as the panel it came from, at full width: the cover */
	/* printed in the entry's channel, so the view transition morphs a picture */
	/* into the same picture rather than into a different treatment of it. */
	.case__hero {
		position: relative;
		display: grid;
		align-content: end;
		min-block-size: min(78svh, 720px);
		margin-inline: calc(50% - 50vw);
		padding-block-end: var(--s-12);
		overflow: clip;
		isolation: isolate;
	}

	.case__media {
		position: absolute;
		inset: 0;
		z-index: -1;
	}

	.case__frame {
		position: absolute;
		inset: 0;
		display: block;
		overflow: clip;
	}

	.case__media :global(img) {
		position: absolute;
		inset-inline: 0;
		inset-block-start: -8%;
		inline-size: 100%;
		block-size: 116%;
		object-fit: cover;
	}

	/* Parallax, matching the panels. Scroll-driven, transform only, zero JS. */
	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.case__media :global(img) {
				animation: case-parallax linear both;
				animation-timeline: view();
				animation-range: cover 0% cover 100%;
			}
		}
	}

	@keyframes case-parallax {
		from {
			translate: 0 -6%;
		}
		to {
			translate: 0 6%;
		}
	}

	.case__bracket {
		position: absolute;
		z-index: 2;
		inline-size: 26px;
		block-size: 26px;
		pointer-events: none;
		border-color: var(--accent);
		opacity: 0.85;
	}

	.case__bracket--tl {
		inset-block-start: 16px;
		inset-inline-start: 16px;
		border-block-start: 2px solid;
		border-inline-start: 2px solid;
	}
	.case__bracket--tr {
		inset-block-start: 16px;
		inset-inline-end: 16px;
		border-block-start: 2px solid;
		border-inline-end: 2px solid;
	}
	.case__bracket--bl {
		inset-block-end: 16px;
		inset-inline-start: 16px;
		border-block-end: 2px solid;
		border-inline-start: 2px solid;
	}
	.case__bracket--br {
		inset-block-end: 16px;
		inset-inline-end: 16px;
		border-block-end: 2px solid;
		border-inline-end: 2px solid;
	}

	/* ---- headline -------------------------------------------------------- */

	/* The meta line and the title sit on the cover, each on a plate of the */
	/* field -- a broadcast lower third. The plates replace a scrim that kept */
	/* them legible by darkening the whole photograph. */
	.case__headline {
		position: relative;
		display: grid;
		justify-items: start;
		gap: var(--s-3);
	}

	.case__meta {
		inline-size: fit-content;
		padding: var(--s-2) var(--s-3);
		background: var(--field);
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2) var(--s-3);
		align-items: center;
		font-family: var(--font-mono);
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--mark-dim);
	}

	.case__index {
		font-size: var(--t-lg);
		font-weight: 700;
		color: var(--accent);
		line-height: 1;
	}

	.case__sep {
		color: var(--mark-dim);
	}

	/* Same container-query sizing as the panels: an element cannot be its own
	   container, and `overflow-wrap: break-word` from the reset will split a
	   word in half rather than let it overflow. */
	.case__titlebox {
		container-type: inline-size;
	}

	.case__titlebox {
		inline-size: 100%;
	}

	/* 14cqi for the same reason as the panel title: CHROMECAST is 6.8em in */
	/* Martian Mono at -0.02em tracking, plus the plate. */
	.case__title {
		font-size: min(clamp(2.75rem, 1rem + 7vw, 7rem), 14cqi);
		line-height: 0.92;
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
	}

	.case__plate {
		padding-inline-end: 0.15em;
		background: var(--field);
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}

	/* ---- idle signal bars, as on the panels ------------------------------ */

	.case__bars {
		display: inline-flex;
		align-items: flex-end;
		gap: 2px;
		block-size: 0.9em;
	}

	.case__bars i {
		inline-size: 2px;
		block-size: 100%;
		background: var(--accent);
		transform-origin: 50% 100%;
		scale: 1 0.35;
		animation: case-bars 2.6s ease-in-out infinite;
	}

	.case__bars i:nth-child(1) {
		animation-duration: 1.7s;
		animation-delay: -0.4s;
	}
	.case__bars i:nth-child(2) {
		animation-duration: 2.3s;
		animation-delay: -1.1s;
	}
	.case__bars i:nth-child(3) {
		animation-duration: 3.1s;
		animation-delay: -0.7s;
	}
	.case__bars i:nth-child(4) {
		animation-duration: 1.9s;
		animation-delay: -1.9s;
	}

	@keyframes case-bars {
		0%,
		100% {
			scale: 1 0.3;
		}
		50% {
			scale: 1 1;
		}
	}

	/* ---- body ------------------------------------------------------------ */

	/* Full bleed, so the paper runs edge to edge; its children re-wrap. */
	.case__reading {
		margin-inline: calc(50% - 50vw);
	}

	.case__body {
		display: grid;
		gap: var(--s-6);
		padding-block: var(--s-12) var(--s-8);
	}

	.case__lede {
		max-width: var(--measure);
		font-size: var(--t-lg);
		line-height: 1.45;
		color: var(--mark);
		border-inline-start: 3px solid var(--mark);
		padding-inline-start: var(--s-4);
	}

	.case__body :global(.prose) {
		max-width: var(--measure);
	}

	/* ---- links ----------------------------------------------------------- */

	.case__links ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-3);
		list-style: none;
		padding: 0;
	}

	.case__links a {
		position: relative;
		display: inline-block;
		padding: var(--s-3) var(--s-4);
		border: 1px solid var(--accent);
		color: var(--accent);
		text-decoration: none;
		overflow: clip;
		transition:
			background-color var(--speed) var(--ease),
			color var(--speed) var(--ease),
			translate var(--speed) var(--ease);
	}

	.case__links a:hover,
	.case__links a:focus-visible {
		background: var(--accent);
		color: var(--field);
		translate: 0 -2px;
	}

	/* ---- sequence: this is one of several, not a dead end ---------------- */

	.case__nav {
		display: grid;
		gap: var(--s-6);
		padding-block: var(--s-8) var(--s-16);
		border-block-start: 1px solid var(--line);
	}

	.case__back {
		font-size: var(--t-sm);
		color: var(--mark-dim);
		text-underline-offset: 0.3em;
	}

	.case__back:hover,
	.case__back:focus-visible {
		color: var(--accent);
	}

	.case__sequence {
		display: grid;
		gap: var(--s-4);
	}

	/* Each step is a preview of the channel it goes to: channel up, channel */
	/* down. The colours sit on an inner plate, not on the link, so the link's */
	/* focus ring stays in the reading channel's mark -- a ring in the */
	/* destination's paper mark would vanish against this paper. */
	.case__step {
		display: grid;
		text-decoration: none;
		transition: translate var(--speed) var(--ease);
	}

	.case__stepplate {
		display: grid;
		gap: var(--s-1);
		padding: var(--s-4);
		background: var(--field);
		color: var(--mark);
	}

	.case__step:hover,
	.case__step:focus-visible {
		translate: 0 -3px;
	}

	.case__steplabel {
		font-family: var(--font-mono);
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--mark-dim);
	}

	.case__steptitle {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--t-lg);
		letter-spacing: var(--tracking-display);
	}

	.case__step--next {
		text-align: end;
	}

	@media (min-width: 48rem) {
		.case__sequence {
			grid-template-columns: 1fr 1fr;
		}

		/* A lone "next" belongs on the right, where next always is. */
		.case__step--next:only-child {
			grid-column: 2;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.case__bars i {
			animation: none;
			scale: 1 0.7;
		}
	}
</style>
