---
import { getImage, Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Guide from '@components/Guide.astro';
import { formatPeriod, getPublishedWork, type PublishedWorkEntry } from '@lib/work';
import { channelStyle } from '@lib/channels';
import { vt } from '@lib/vt';
import { site } from '@lib/site';

/**
 * A case study, as the programme-information screen of the guide it came from.
 *
 * Same channel, same picture, same title -- the view transition carries the
 * guide's preview straight into this page -- and the guide itself runs along
 * the bottom with this programme lit, so moving to the next piece of work is
 * changing channel rather than going back to a list. There is no site header;
 * the way out is the Guide button, or Escape, like the Back key on a remote.
 */
interface Props {
	entry: PublishedWorkEntry;
	index: string;
}

const { entry, index } = Astro.props;
const { title, role, company, summary, tags, channel, cover, coverAlt, links, status } = entry.data;
const all = await getPublishedWork();
const lastYear = entry.data.period.split('–').pop();

// The link preview: the key art, cropped to the card's 1200x630.
const shareArt = await getImage({
	src: cover,
	width: 1200,
	height: 630,
	fit: 'cover',
	format: 'jpg',
	quality: 80,
});
const share = { src: shareArt.src, width: 1200, height: 630, alt: coverAlt };

// The case study for search engines: a piece of work, and who wrote it up.
const work = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: title,
	description: summary,
	url: new URL(`/work/${entry.id}`, site.url).href,
	image: new URL(shareArt.src, site.url).href,
	keywords: tags.join(', '),
	author: { '@type': 'Person', name: site.name, url: `${site.url}/` },
};
---

<BaseLayout
	title={title}
	description={summary}
	ogImage={share}
	jsonLd={work}
	channel={channel}
	bleed
>
	<article class="info" data-channel={channel} style={channelStyle(channel)}>
		<header class="info__head">
			{/* The key art as it is, like the guide's screen it came from, and */}
			{/* the stage everything above the story stands on. */}
			<div
				class="info__screen"
				data-dither-stage
				style={`view-transition-name:${vt('cover', entry.id)}`}
			>
				<Image
					src={cover}
					alt={coverAlt}
					widths={[800, 1280, 1920]}
					sizes="100vw"
					loading="eager"
					fetchpriority="high"
				/>
			</div>

			{/* The way back is pinned to the screen, and stays out of the chrome row */}
			{/* below: that row is a stacking context (its z-index, and its view */}
			{/* transition name), and a fixed element inside one is stacked at the */}
			{/* row's level. The gradient and the titles scrolled over it, and took */}
			{/* its clicks (Rick, 2026-09-25: "works weirdly with z-index"). */}
			<a class="info__back" href="/#work" data-back>
				<span aria-hidden="true">←</span> Guide
				<span class="keyhint" aria-hidden="true">
					Esc
				</span>
			</a>

			<div class="info__chrome">
				<p class="info__osd" aria-hidden="true">
					CH {index} <b>{title.split(' ')[0]}</b>
				</p>
			</div>

			<span class="info__foot" aria-hidden="true"></span>
			<div class="info__titles">
				{/* Title first, then its status: a programme page's order, and */}
				{/* the status is small text, so it wants the stronger field lower */}
				{/* down the foot, not the thin top of it. */}
				<div class="info__titlebox">
					<h1 class="info__title" style={`view-transition-name:${vt('title', entry.id)}`}>
						{title}
					</h1>
				</div>
				<p class="info__status">
					{status === 'ongoing' ? (
						<span class="onair onair--live">On air</span>
					) : (
						<span class="onair onair--ended">Ended {lastYear}</span>
					)}
				</p>
				<p class="info__lede">{summary}</p>
				{links.length > 0 && (
					<ul class="info__actions">
						{links.map((l, i) => (
							<li>
								<a
									class:list={['tvbtn', { 'tvbtn--solid': i === 0 }]}
									href={l.href}
									target="_blank"
									rel="noopener noreferrer"
								>
									{l.label}
									<span aria-hidden="true">↗</span>
									<span class="visually-hidden">(opens in a new tab)</span>
								</a>
							</li>
						))}
					</ul>
				)}
			</div>
		</header>

		<div class="info__main wrap">
			{/* The labelled key/value block, 2xA-style: facts, not prose. */}
			<dl class="info__facts">
				<div>
					<dt>Channel</dt>
					<dd>{index}</dd>
				</div>
				<div>
					<dt>Role</dt>
					<dd>{role}</dd>
				</div>
				<div>
					<dt>Company</dt>
					<dd>{company}</dd>
				</div>
				<div>
					<dt>On air</dt>
					<dd>{formatPeriod(entry)}</dd>
				</div>
				{/* Tags, not Stack: they name the platform and the kind of work as */}
				{/* well as the code ("Connected TV / Advertisements / THEOplayer"). */}
				<div>
					<dt>Tags</dt>
					<dd>{tags.join(' / ')}</dd>
				</div>
			</dl>

			<div class="info__body prose">
				<slot />
			</div>
		</div>

		{/* No channel up/down: the guide underneath is the way to every other */}
		{/* programme, and it had been saying the same as the buttons above it */}
		{/* (Rick, 2026-09-25). */}
		<div class="info__guide">
			<Guide entries={all} form="strip" current={entry.id} />
		</div>
	</article>
</BaseLayout>

<script>
	import { decode } from '../lib/decode';

	// The title tunes in as the page arrives -- once the display face is in, so
	// each letter is measured in it rather than in the fallback.
	void document.fonts.ready.then(() => decode(document.querySelector<HTMLElement>('.info__title')));

	/*
	 * Escape goes back to the guide, like the Back key on a remote. Straight
	 * back through history when the visitor came from the one-pager, so the
	 * guide is where they left it; otherwise to the guide itself. Never while
	 * typing, and never when something else already took the key. Backspace
	 * did the same until 2026-09-29: browsers dropped it as Back years ago,
	 * because it cost people what they had typed, and nobody expects it here.
	 */
	const back = document.querySelector<HTMLAnchorElement>('[data-back]');

	function cameFromGuide(): boolean {
		if (!document.referrer) return false;
		const ref = new URL(document.referrer);
		return ref.origin === location.origin && ref.pathname === '/' && history.length > 1;
	}

	if (back) {
		back.addEventListener('click', (ev) => {
			if (!cameFromGuide()) return;
			ev.preventDefault();
			history.back();
		});

		window.addEventListener('keydown', (ev) => {
			if (ev.key !== 'Escape') return;
			if (ev.defaultPrevented || ev.metaKey || ev.ctrlKey || ev.altKey) return;
			const el = ev.target as HTMLElement | null;
			if (el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName))) return;
			ev.preventDefault();
			if (cameFromGuide()) history.back();
			else location.assign(back.href);
		});

		// On a narrow screen the facts are not beside the story, and the way back,
		// pinned to the top, sat over the line being read. It steps out of the
		// way as the page goes down and comes back the moment it goes up. A
		// flag, flipped only when the direction changes; the move is CSS.
		const narrow = window.matchMedia('(max-width: 63.99rem)');
		let lastY = window.scrollY;
		window.addEventListener(
			'scroll',
			() => {
				const y = window.scrollY;
				if (Math.abs(y - lastY) < 8) return;
				const away = narrow.matches && y > lastY && y > window.innerHeight * 0.5;
				if (away !== back.hasAttribute('data-away')) back.toggleAttribute('data-away', away);
				lastY = y;
			},
			{ passive: true },
		);
	}
</script>

<style>
	/* ---- the screen ------------------------------------------------------- */

	/* Full bleed, so the channel's ground runs edge to edge; children re-wrap. */
	.info {
		padding-block: 0;
	}

	/* ---- chrome: the way back, and where you are --------------------------- */

	/* On the stage, in the page's column, above the picture. */
	.info__chrome {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--s-4);
		inline-size: min(100% - var(--gutter) * 2, var(--wrap));
		min-block-size: 44px;
		margin-inline: auto;
		margin-block-start: var(--s-6);
		view-transition-name: info-chrome;
	}

	/* App chrome, not a header: pinned to the corner of the screen, on a plate */
	/* of the channel so it stays legible over the picture as the page scrolls. */
	/* Level with the channel on the right: the same top, the same height, and */
	/* the column's own left edge rather than the corner of the screen. The */
	/* formula is .wrap's; 100% of a fixed box's containing block is the */
	/* viewport without its scrollbar, so it lands where the column does. */
	.info__back {
		position: fixed;
		z-index: var(--z-nav);
		/* A layer of its own in the page transition, as it had inside the */
		/* chrome row: in the page's own layer it sat under the flying picture. */
		view-transition-name: info-back;
		inset-block-start: var(--s-6);
		inset-inline-start: max(var(--gutter), (100% - var(--wrap)) / 2);
		display: inline-flex;
		align-items: center;
		gap: var(--s-3);
		min-block-size: 44px;
		padding-inline: var(--s-4);
		background: var(--field);
		border: 2px solid var(--mark);
		color: var(--mark);
		font-family: var(--font-mono);
		font-size: var(--t-sm);
		font-weight: 700;
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		text-decoration: none;
		transition:
			background-color var(--speed) var(--ease),
			color var(--speed) var(--ease),
			translate var(--speed) var(--ease-out);
	}

	.info__back:hover,
	.info__back:focus-visible {
		background: var(--mark);
		color: var(--field);
	}

	/* Out of the way while the story is read on a narrow screen (the script */
	/* below): up off the top as the page goes down, back as soon as it goes */
	/* up. Pinned over the text, it covered the line being read on every phone */
	/* case study. Never while it has focus. */
	.info__back[data-away]:not(:focus-visible) {
		translate: 0 calc(-100% - var(--s-6) - 4px);
	}

	/* A chip to match the back button: the same height, frame and field, so */
	/* the two sit on one line as a pair. It stays a plate, unlike the title: */
	/* over a white photograph a fade thin enough to keep the picture left */
	/* the channel at 1:1. */
	.info__osd {
		display: flex;
		align-items: center;
		min-block-size: 44px;
		margin-inline-start: auto;
		padding-inline: var(--s-4);
		background: var(--field);
		border: 2px solid var(--mark);
		font-family: var(--font-display);
		font-size: var(--t-lg);
		letter-spacing: 0.04em;
		color: var(--mark);
	}

	.info__osd b {
		margin-inline-start: 0.5em;
		color: var(--accent);
		text-transform: uppercase;
	}

	/* ---- head: the picture, and what it is --------------------------------- */

	/* A stage, not a screen beside the title: the key art edge to edge across */
	/* most of the first screen, the way a streaming app opens a programme, */
	/* with the way back, the channel and the title standing on it (Rick, */
	/* 2026-09-25: "the image can be full size with more parallax effect"). */
	/* Its own view timeline, --head, drives the parallax below. */
	.info__head {
		position: relative;
		display: grid;
		grid-template-rows: auto minmax(0, 1fr) auto;
		min-block-size: 84svh;
		view-timeline: --head block;
	}

	/* No frame line along the foot: the gradient's solid base covers the */
	/* screen's bottom edge at rest, so a line there only ever showed mid-scroll, */
	/* as a hairline of its own. */
	.info__screen {
		position: absolute;
		inset: 0;
		overflow: clip;
		view-transition-class: vt-cover;
	}

	/* What the foot leaves behind as it lifts. The stage moves with the page */
	/* and the foot lifts faster, so a strip of bare picture opened under the */
	/* gradient's solid base -- 57px of white photograph by 300px of scroll */
	/* (Rick, 2026-09-25: "broken on the gradient"). A band of the field, */
	/* waiting below the screen's bottom edge where its clip hides it, rises on */
	/* the foot's timeline: always 4px higher than the foot has lifted, so it */
	/* runs UNDER the foot's solid base. Grown to meet the foot's edge exactly, */
	/* it left a one-pixel seam of photograph where the two edges met. */
	.info__screen::after {
		content: '';
		position: absolute;
		inset-inline: 0;
		inset-block-start: 100%;
		block-size: calc(16vh + 4px);
		background: var(--field);
		transform: translateY(-4px);
	}

	/* The picture runs out into the field at its foot, where the title stands */
	/* -- the field, not a darker shade, as on the interludes. Rick found plates */
	/* behind the text heavy (2026-09-25). It shares the title's grid row, the */
	/* full width of the stage, and rises 24vh above it, so however tall the */
	/* title is, the gradient is sized to it: solid behind the synopsis, never */
	/* less than about two thirds field behind the title -- a white photograph */
	/* needs half for 3:1 -- and clear above. A test measures the pixels. */
	/* Its own layer in the view transition, like the chrome row: the picture */
	/* flies in as a layer of its own, and anything left in the page beneath */
	/* it was hidden until the transition ended -- the title morphed across a */
	/* bare white photograph, then the gradient popped in under it. */
	.info__foot {
		grid-row: 3;
		grid-column: 1;
		z-index: 1;
		margin-block-start: -24vh;
		pointer-events: none;
		view-transition-name: info-foot;
		background: linear-gradient(
			to top,
			var(--field) 0%,
			var(--field) 26%,
			color-mix(in oklab, var(--field) 55%, transparent) 68%,
			transparent 100%
		);
	}

	/* Oversized top and bottom: it scrolls slower than the page, and the */
	/* travel must never show an edge. */
	.info__screen :global(img) {
		position: absolute;
		inset-inline: 0;
		inset-block-start: -15%;
		inline-size: 100%;
		block-size: 130%;
		object-fit: cover;
	}

	/* The 1-bit print (src/lib/dither/) over the stage: the key art in its own */
	/* colours, its push and parallax redrawn under a fixed dot grid, and the */
	/* foot's fade dithered into the field, clear of the title. While it draws, */
	/* the <img> under it rests and the foot's gradient steps aside. */
	.info__screen > :global(canvas) {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		image-rendering: pixelated;
		pointer-events: none;
	}

	.info__screen[data-dither-stage='on'] > :global(img) {
		visibility: hidden;
		animation: none;
	}

	.info__screen[data-dither-stage='on'] ~ .info__foot {
		background: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		.info__screen :global(img) {
			animation: info-push 24s ease-in-out infinite alternate;
		}

		/* Parallax, on the page's own scroll. As the head leaves, the picture */
		/* falls behind the page to half its speed and zooms in, the title lifts */
		/* away faster than the page, and the guide rises into place as it */
		/* arrives. The head starts at the top of the page, so every range starts */
		/* at rest and the page loads exactly as laid out. Transform only. */
		@supports (animation-timeline: view()) {
			.info__screen :global(img) {
				animation:
					info-push 24s ease-in-out infinite alternate,
					info-backdrop linear both;
				animation-timeline: auto, --head;
				animation-range:
					normal,
					exit 0% exit 100%;
			}

			/* The foot lifts with the title, so the title never leaves its field, */
			/* and the screen's band rises behind it at the same rate. */
			.info__titles,
			.info__foot {
				animation: info-lift linear both;
				animation-timeline: --head;
				animation-range: exit 0% exit 100%;
			}

			.info__screen::after {
				animation: info-fill linear both;
				animation-timeline: --head;
				animation-range: exit 0% exit 100%;
			}

			.info__guide {
				animation: info-arrive linear both;
				animation-timeline: view();
				animation-range: entry 0% entry 90%;
			}
		}
	}

	/* 38% of a picture 130% the head's height is 49% of the head: over the */
	/* head's exit the picture moves down half as far as the page moves up. */
	/* Its top starts 15% above the head and never comes into view. */
	@keyframes info-backdrop {
		to {
			transform: translateY(38%) scale(1.12);
		}
	}

	@keyframes info-lift {
		to {
			transform: translateY(-16vh);
		}
	}

	/* The lift is 16vh; the band starts 4px up and rises 16vh more on the */
	/* same range, so it always stands 4px above the foot's lower edge. */
	@keyframes info-fill {
		to {
			transform: translateY(calc(-16vh - 4px));
		}
	}

	/* Transform only: fading the strip in would leave it half-transparent, */
	/* and half-transparent text is text below its contrast floor. */
	@keyframes info-arrive {
		from {
			transform: translateY(12vh);
		}
	}

	@keyframes info-push {
		from {
			scale: 1.02;
		}
		to {
			scale: 1.1;
			translate: -1.5% -1%;
		}
	}

	/* The title stands on the picture's foot, in the page's column, on the */
	/* gradient above. One left edge for all of it. */
	.info__titles {
		position: relative;
		z-index: 2;
		grid-row: 3;
		grid-column: 1;
		display: grid;
		justify-items: start;
		gap: var(--s-4);
		inline-size: min(100% - var(--gutter) * 2, var(--wrap));
		min-inline-size: 0;
		margin-inline: auto;
		padding-block: var(--s-16) var(--s-8);
	}

	.info__titlebox {
		inline-size: 100%;
		container-type: inline-size;
	}

	/* 16cqi: CHROMECAST is 6.1em in Bricolage at the display tracking. */
	/* The -0.03em is the capitals' own side bearing: without it the title's */
	/* ink starts a few pixels right of the lines above and below it. */
	.info__title {
		view-transition-class: vt-title;
		margin-inline-start: -0.03em;
		font-size: min(clamp(2.75rem, 1rem + 6vw, 7rem), 16cqi);
		line-height: 0.92;
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
	}

	.info__lede {
		max-inline-size: 40rem;
		font-size: var(--t-lg);
		line-height: 1.45;
		text-wrap: pretty;
	}

	.info__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-4);
		list-style: none;
		padding: 0;
		margin-block-start: var(--s-2);
	}

	/* ---- main: the facts, and the story ------------------------------------ */

	.info__main {
		display: grid;
		gap: var(--s-8);
		margin-block-start: var(--s-12);
	}

	.info__facts {
		display: grid;
		gap: var(--s-3);
		align-content: start;
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--t-sm);
	}

	.info__facts div {
		display: grid;
		grid-template-columns: 6.5rem minmax(0, 1fr);
		gap: var(--s-3);
		padding-block-end: var(--s-3);
		border-block-end: 1px solid var(--line);
	}

	.info__facts dt {
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--accent);
		padding-block-start: 0.15em;
	}

	.info__facts dd {
		margin: 0;
		color: var(--mark);
	}

	.info__body {
		font-size: var(--t-base);
		line-height: 1.7;
	}

	.info__body :global(strong) {
		color: var(--accent);
		font-weight: 700;
	}

	.info__body :global(a) {
		color: var(--accent);
	}

	/* ---- the guide, along the bottom --------------------------------------- */

	.info__guide {
		margin-block-start: var(--s-12);
		padding-block: var(--s-8) var(--s-12);
		border-block-start: 1px solid var(--line);
	}

	/* ---- narrow screens ----------------------------------------------------- */

	/* On a phone the back button and the channel met in the middle. */
	@media (max-width: 30rem) {
		.info__back .keyhint {
			display: none;
		}

		.info__osd {
			font-size: var(--t-sm);
		}
	}

	/* ---- wide screens ------------------------------------------------------- */

	@media (min-width: 64rem) {
		.info__main {
			grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
			gap: var(--s-16);
		}

		/* The facts stay beside the story as it scrolls. Aligned to the start of */
		/* their row: stretched to the row, as a grid item is, the box was as tall */
		/* as the story, had no room to stick, and scrolled up under the way back */
		/* at the top of the screen instead. */
		.info__facts {
			position: sticky;
			inset-block-start: var(--s-24);
			align-self: start;
		}
	}
</style>
