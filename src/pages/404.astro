---
import BaseLayout from '@layouts/BaseLayout.astro';
import Card from '@components/Card.astro';
import type { TicketCard } from '@lib/deck';

// The 404 is one ticket that is not turned over. It EXISTS so Firebase serves
// a real HTTP 404 rather than the homepage with a 200.
const ticket: TicketCard = {
	id: 'lost',
	kind: 'ticket',
	number: 'RG 404',
	label: 'Lost: page 404',
	pigment: 'yellow',
	title: 'Lost: page 404',
	links: [{ label: 'Back to the table', href: '/' }],
};
---

<BaseLayout title="Page not found" description="That page does not exist." noindex={true}>
	<div class="table lost">
		<Card card={ticket} index={0} level={1} flippable={false} />
	</div>
</BaseLayout>

<style>
	.lost {
		column-count: 1;
		max-width: 640px;
		padding-top: 96px;
	}
</style>
