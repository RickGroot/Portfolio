---
import BaseLayout from '@layouts/BaseLayout.astro';
import Card from '@components/Card.astro';
import shareCard from '@assets/share/home.png';
import { socialLinks } from '@lib/social';
import { getDeck } from '@lib/deck';
import { site } from '@lib/site';

// The whole site is this deck: every card is one piece of work, or a part of
// Rick, in the order it lies on the table.
const deck = await getDeck();

// The link preview: the table itself, rendered once at 1200x630 from the
// built page and committed. See src/assets/IMAGES.md.
const share = {
	src: shareCard.src,
	width: shareCard.width,
	height: shareCard.height,
	alt: 'Rick Groot’s portfolio: a table of loose cards, among them a record sleeve, a cassette and a TV listing, each a piece of TV work.',
};

// Who the site is about, for search engines. Links to no origin but his own
// profiles (check-assets allows no others).
const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: site.name,
	jobTitle: site.tagline,
	url: `${site.url}/`,
	// Open to work: Hypersolid is a former employer, so alumniOf, not worksFor.
	alumniOf: { '@type': 'Organization', name: 'Hypersolid' },
	homeLocation: { '@type': 'Country', name: 'Netherlands' },
	sameAs: socialLinks.filter((l) => !l.href.startsWith('mailto:')).map((l) => l.href),
};
---

<BaseLayout title={site.name} description={site.description} ogImage={share} jsonLd={person}>
	<div class="bar mono">
		<ul class="reach" aria-label="Contact">
			{socialLinks.map((l) => (
				<li>
					<a class="chip" href={l.href} rel={l.href.startsWith('mailto:') ? undefined : 'noopener'}>
						{l.label}
					</a>
				</li>
			))}
		</ul>
		<button class="still-toggle chip" type="button" aria-pressed="false">
			Pause motion
		</button>
	</div>
	<div class="table">
		{/* The contact ticket carries its links on its front: they are what it is for. */}
		{deck.map((card, i) => (
			<Card
				card={card}
				index={i}
				level={card.kind === 'player' ? 1 : 2}
				eager={i < 2}
				flippable={card.kind !== 'ticket'}
				tearable={card.kind === 'ticket'}
			/>
		))}
	</div>
</BaseLayout>
