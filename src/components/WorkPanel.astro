---
import { Image } from 'astro:assets';
import TagList from './TagList.astro';
import { formatPeriod, type PublishedWorkEntry } from '@lib/work';
import { vt } from '@lib/vt';
import { NEGATIVE_PRINT } from '@lib/channels';

interface Props {
	entry: PublishedWorkEntry;
	index: string;
}

const { entry, index } = Astro.props;
const { title, role, company, summary, tags, cover, coverInvert } = entry.data;
const href = `/work/${entry.id}`;
---

{/* No colours of its own: the panel is drawn in the channel of the section */}
{/* that holds it. */}
<article class="panel">
	<p class="panel__meta">
		<span class="panel__index" aria-hidden="true">
			{index}
		</span>
		<span class="panel__bars" aria-hidden="true">
			<i></i>
			<i></i>
			<i></i>
			<i></i>
		</span>
		<span>{role}</span>
		<span class="panel__sep" aria-hidden="true">
			/
		</span>
		<span>{company}</span>
		<span class="panel__sep" aria-hidden="true">
			/
		</span>
		<span>{formatPeriod(entry)}</span>
	</p>

	<a
		class="panel__media"
		href={href}
		tabindex="-1"
		aria-hidden="true"
		style={`view-transition-name:${vt('cover', entry.id)}`}
	>
		<span class="panel__frame duo" style={coverInvert ? NEGATIVE_PRINT : undefined}>
			<Image
				src={cover}
				alt=""
				widths={[800, 1400, 2000]}
				sizes="(min-width: 60rem) 76vw, 94vw"
				loading={index === '01' ? 'eager' : 'lazy'}
				decoding="async"
			/>
		</span>
		<span class="panel__bracket panel__bracket--tl"></span>
		<span class="panel__bracket panel__bracket--tr"></span>
		<span class="panel__bracket panel__bracket--bl"></span>
		<span class="panel__bracket panel__bracket--br"></span>
	</a>

	<div class="panel__body">
		<div class="panel__titlebox">
			<h3 class="panel__title" style={`view-transition-name:${vt('title', entry.id)}`}>
				<a href={href}>{title}</a>
			</h3>
		</div>
		<div class="panel__detail">
			<p class="panel__summary">{summary}</p>
			<TagList tags={tags} />
			<p class="panel__more">
				<a href={href}>
					Read the case study <span aria-hidden="true">→</span>
				</a>
			</p>
		</div>
	</div>
</article>

<style>
	.panel {
		display: grid;
		grid-template-rows: auto 1fr auto;
		gap: var(--s-4);
		block-size: 100%;
		min-block-size: 0;
	}

	/* ---- meta line ------------------------------------------------------- */

	.panel__meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2) var(--s-3);
		align-items: center;
		font-family: var(--font-mono);
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--mark-dim);
	}

	.panel__index {
		font-size: var(--t-lg);
		font-weight: 700;
		color: var(--accent);
		line-height: 1;
	}

	.panel__sep {
		color: var(--mark-dim);
	}

	/* ---- media: the biggest thing on the screen -------------------------- */

	/* A hard frame in the mark, and nothing else: no radius, no shadow. The */
	/* panel sits flat on its channel like a picture on a screen. The floor */
	/* holds at every width, not just on phones: the picture's row is a 1fr */
	/* track, and on a short screen the title and summary take their height */
	/* first -- without a floor the picture is what gets squeezed out. */
	.panel__media {
		position: relative;
		display: block;
		min-block-size: min(34svh, 300px);
		overflow: clip;
		border: 1px solid var(--mark);
		background: var(--field);
		isolation: isolate;
	}

	/* The frame crops; the image inside is oversized so it can travel without
	   ever exposing an edge. */
	.panel__frame {
		position: absolute;
		inset: 0;
		display: block;
		overflow: clip;
	}

	.panel__media :global(img) {
		position: absolute;
		inset-inline: 0;
		inset-block-start: -9%;
		inline-size: 100%;
		block-size: 118%;
		object-fit: cover;
		transition:
			scale var(--speed-slow) var(--ease-out),
			filter var(--speed-slow) var(--ease-out);
	}

	/* The cover is printed in the channel's two colours (surfaces.css .duo) */
	/* and comes back in its own colours under the pointer or keyboard focus. */
	/* The shader version of this reveal replaces it once the renderer lands; */
	/* this is what every browser without WebGL keeps. */
	.panel__frame::after {
		transition: opacity var(--speed-slow) var(--ease-out);
	}

	/* Parallax. Scroll-driven, zero JS, transform only. */
	/* The image is 118% of the frame and starts 9% high, so an 8% travel never */
	/* reveals a gap. cover 0% -> cover 100% maps the whole time the section is */
	/* on screen, which is what makes it track the scroll rather than jump. */
	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.panel__media :global(img) {
				animation: parallax linear both;
				animation-timeline: view();
				animation-range: cover 0% cover 100%;
			}
		}
	}

	@keyframes parallax {
		from {
			translate: 0 -8%;
		}
		to {
			translate: 0 8%;
		}
	}

	/* Corner brackets: a viewport, not a card. */
	.panel__bracket {
		position: absolute;
		inline-size: 22px;
		block-size: 22px;
		z-index: 2;
		pointer-events: none;
		border-color: var(--accent);
		opacity: 0;
		transition:
			opacity var(--speed) var(--ease),
			translate var(--speed-slow) var(--ease-out);
	}

	.panel__bracket--tl {
		inset-block-start: 12px;
		inset-inline-start: 12px;
		border-block-start: 2px solid;
		border-inline-start: 2px solid;
		translate: 8px 8px;
	}
	.panel__bracket--tr {
		inset-block-start: 12px;
		inset-inline-end: 12px;
		border-block-start: 2px solid;
		border-inline-end: 2px solid;
		translate: -8px 8px;
	}
	.panel__bracket--bl {
		inset-block-end: 12px;
		inset-inline-start: 12px;
		border-block-end: 2px solid;
		border-inline-start: 2px solid;
		translate: 8px -8px;
	}
	.panel__bracket--br {
		inset-block-end: 12px;
		inset-inline-end: 12px;
		border-block-end: 2px solid;
		border-inline-end: 2px solid;
		translate: -8px -8px;
	}

	.panel:hover .panel__bracket,
	.panel:focus-within .panel__bracket {
		opacity: 1;
		translate: 0 0;
	}

	.panel:hover .panel__frame::after,
	.panel:focus-within .panel__frame::after {
		opacity: 0;
	}

	.panel:hover .panel__media :global(img),
	.panel:focus-within .panel__media :global(img) {
		scale: 1.04;
		filter: none;
	}

	/* ---- title and detail ------------------------------------------------ */

	.panel__body {
		display: grid;
		gap: var(--s-4);
		align-items: end;
	}

	/* Sized against its own column, not the viewport. The reset sets */
	/* overflow-wrap: break-word on headings, which is right for prose and */
	/* catastrophic here: it once split CHROMECAST into CHROMECA / ST rather */
	/* than overflowing. Martian Mono advances exactly 0.7em per glyph, so at */
	/* -0.02em tracking the ten letters of CHROMECAST need 6.8em, plus the */
	/* plate's 0.15em: 6.95em x 14cqi = 97% of the column, at every width. A */
	/* test asserts no title breaks. */
	.panel__titlebox {
		container-type: inline-size;
	}

	/* Big. This is the thing you should be able to read across the room. */
	.panel__title {
		font-size: min(clamp(2.75rem, 1rem + 7vw, 7rem), 14cqi);
		line-height: 0.92;
		letter-spacing: var(--tracking-display);
		text-transform: uppercase;
	}

	/* The plate: the title sits on a block of its own field, so where it */
	/* crosses the cover it reads as cut out of the picture, the way a */
	/* broadcast lower third does. It replaces the text-shadow that used to */
	/* keep the title legible by darkening whatever was behind it. Cloned per */
	/* line, so a two-line title gets two plates that hug their words. */
	.panel__title a {
		padding-inline-end: 0.15em;
		background-color: var(--field);
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
		text-decoration: none;
		background-image: linear-gradient(var(--accent), var(--accent));
		background-repeat: no-repeat;
		background-position: 0 100%;
		background-size: 0% 3px;
		transition: background-size var(--speed-slow) var(--ease-out);
	}

	.panel__title a:hover,
	.panel__title a:focus-visible {
		background-size: 100% 3px;
	}

	.panel__detail {
		display: grid;
		gap: var(--s-3);
		max-width: var(--measure);
	}

	.panel__summary {
		color: var(--mark-dim);
		font-size: var(--t-lg);
	}

	.panel__more a {
		color: var(--accent);
		font-size: var(--t-sm);
		text-underline-offset: 0.3em;
	}

	/* ---- idle signal bars ------------------------------------------------ */

	.panel__bars {
		display: inline-flex;
		align-items: flex-end;
		gap: 2px;
		block-size: 0.9em;
	}

	.panel__bars i {
		inline-size: 2px;
		block-size: 100%;
		background: var(--accent);
		transform-origin: 50% 100%;
		scale: 1 0.35;
		animation: bars 2.6s ease-in-out infinite;
	}

	/* Co-prime durations and negative delays: nothing starts aligned and the */
	/* loop does not visibly repeat. */
	.panel__bars i:nth-child(1) {
		animation-duration: 1.7s;
		animation-delay: -0.4s;
	}
	.panel__bars i:nth-child(2) {
		animation-duration: 2.3s;
		animation-delay: -1.1s;
	}
	.panel__bars i:nth-child(3) {
		animation-duration: 3.1s;
		animation-delay: -0.7s;
	}
	.panel__bars i:nth-child(4) {
		animation-duration: 1.9s;
		animation-delay: -1.9s;
	}

	@keyframes bars {
		0%,
		100% {
			scale: 1 0.3;
		}
		50% {
			scale: 1 1;
		}
	}

	/* ---- narrow screens -------------------------------------------------- */

	/* On a phone the stacked title, summary, tags and link left the image with
	   188px on an iPhone 13 -- not a showcase by any reading. Floor the media
	   and tighten the detail around it. If a section then exceeds the viewport,
	   the advance script lets it scroll normally before advancing, which is
	   already covered by tests. */
	/* Tags are the first thing to go when height is short: the summary and the
	   link carry the meaning, the tags repeat what the case study says. */
	@media (max-width: 59.99rem) and (max-height: 720px) {
		.panel__detail :global(.tags) {
			display: none;
		}
	}

	@media (max-width: 59.99rem) {
		.panel__media {
			min-block-size: min(40svh, 300px);
		}

		.panel__body {
			gap: var(--s-3);
		}

		.panel__summary {
			font-size: var(--t-base);
		}

		.panel__meta {
			gap: var(--s-1) var(--s-2);
		}
	}

	/* ---- wide screens: the title breaks the frame ------------------------ */

	@media (min-width: 60rem) {
		.panel {
			gap: var(--s-6);
		}

		.panel__body {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
			align-items: start;
			gap: var(--s-8);
			/* Pull the title up over the image's bottom edge. This is what makes */
			/* it read as editorial rather than as a stacked card. */
			margin-block-start: calc(var(--s-12) * -1);
		}

		.panel__titlebox {
			position: relative;
			z-index: 2;
		}

		.panel__detail {
			padding-block-start: var(--s-12);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.panel__bars i {
			animation: none;
			scale: 1 0.7;
		}
	}
</style>
