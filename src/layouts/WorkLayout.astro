---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import TagList from '@components/TagList.astro';
import { formatPeriod, type PublishedWorkEntry } from '@lib/work';
import { ink } from '@lib/accent';
import { vt } from '@lib/vt';

interface Props {
	entry: PublishedWorkEntry;
	index: string;
	prev?: PublishedWorkEntry | undefined;
	next?: PublishedWorkEntry | undefined;
}

const { entry, index, prev, next } = Astro.props;
const { title, role, company, summary, tags, accent, cover, coverAlt, links } = entry.data;
const entryInk = ink(accent);
---

<BaseLayout title={title} description={summary} sectionInk={entryInk}>
	<article class="case" style={`--c-entry-accent:${accent}; --c-entry-ink:${entryInk}`}>
		<header class="case__hero">
			<div class="case__media" style={`view-transition-name:${vt('cover', entry.id)}`}>
				<span class="case__frame">
					<Image
						src={cover}
						alt={coverAlt}
						widths={[900, 1600, 2400]}
						sizes="100vw"
						loading="eager"
						fetchpriority="high"
					/>
				</span>
				<span class="case__dither" aria-hidden="true"></span>
				<span class="case__scrim" aria-hidden="true"></span>
				<span class="case__bracket case__bracket--tl" aria-hidden="true"></span>
				<span class="case__bracket case__bracket--tr" aria-hidden="true"></span>
				<span class="case__bracket case__bracket--bl" aria-hidden="true"></span>
				<span class="case__bracket case__bracket--br" aria-hidden="true"></span>
			</div>

			<div class="case__headline wrap">
				<p class="case__meta">
					<span class="case__index" aria-hidden="true">
						{index}
					</span>
					<span class="case__bars" aria-hidden="true">
						<i></i>
						<i></i>
						<i></i>
						<i></i>
					</span>
					<span>{role}</span>
					<span class="case__sep" aria-hidden="true">
						/
					</span>
					<span>{company}</span>
					<span class="case__sep" aria-hidden="true">
						/
					</span>
					<span>{formatPeriod(entry)}</span>
				</p>
				<div class="case__titlebox">
					<h1 class="case__title" style={`view-transition-name:${vt('title', entry.id)}`}>
						{title}
					</h1>
				</div>
			</div>
		</header>

		<div class="case__body">
			<p class="case__lede" data-reveal>
				{summary}
			</p>
			<div data-reveal>
				<TagList tags={tags} />
			</div>

			<div class="prose" data-reveal>
				<slot />
			</div>

			{links.length > 0 && (
				<div class="case__links" data-reveal>
					<h2 class="visually-hidden">Project links</h2>
					<ul>
						{links.map((l) => (
							<li>
								<a href={l.href} target="_blank" rel="noopener noreferrer" data-proximity>
									{l.label}
									<span aria-hidden="true"> ↗</span>
									<span class="visually-hidden"> (opens in a new tab)</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			)}
		</div>

		<nav class="case__nav" aria-label="Work">
			<a class="case__back" href={`/#${entry.id}`}>
				<span aria-hidden="true">←</span> Back to the overview
			</a>
			<div class="case__sequence">
				{prev && (
					<a class="case__step" href={`/work/${prev.id}`} rel="prev">
						<span class="case__steplabel">Previous</span>
						<span class="case__steptitle">{prev.data.title}</span>
					</a>
				)}
				{next && (
					<a class="case__step case__step--next" href={`/work/${next.id}`} rel="next">
						<span class="case__steplabel">Next</span>
						<span class="case__steptitle">{next.data.title}</span>
					</a>
				)}
			</div>
		</nav>
	</article>
</BaseLayout>

<style>
	/* ---- the hero: the same treatment as a panel, at full width ---------- */

	/* The one-pager dithers every cover to monochrome. This page used to show
	   the raw colour photograph, so the view transition morphed a dithered
	   thumbnail into an untreated image and the page read as a different site.
	   Same treatment, bigger. */
	.case__hero {
		position: relative;
		display: grid;
		align-content: end;
		min-block-size: min(78svh, 720px);
		margin-inline: calc(50% - 50vw);
		padding-block-end: var(--s-12);
		overflow: clip;
		isolation: isolate;
	}

	.case__media {
		position: absolute;
		inset: 0;
		z-index: -1;
	}

	.case__frame {
		position: absolute;
		inset: 0;
		display: block;
		overflow: clip;
	}

	.case__media :global(img) {
		position: absolute;
		inset-inline: 0;
		inset-block-start: -8%;
		inline-size: 100%;
		block-size: 116%;
		object-fit: cover;
		filter: grayscale(0.9) contrast(1.15) brightness(0.5);
	}

	/* Parallax, matching the panels. Scroll-driven, transform only, zero JS. */
	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.case__media :global(img) {
				animation: case-parallax linear both;
				animation-timeline: view();
				animation-range: cover 0% cover 100%;
			}
		}
	}

	@keyframes case-parallax {
		from {
			translate: 0 -6%;
		}
		to {
			translate: 0 6%;
		}
	}

	.case__dither {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background-image:
			radial-gradient(circle at 25% 25%, var(--c-bg) 0.9px, transparent 1.1px),
			radial-gradient(circle at 75% 75%, var(--c-bg) 0.9px, transparent 1.1px);
		background-size: 3px 3px;
		opacity: 0.82;
	}

	/* The title sits on the image, so it needs a floor to stay readable
	   whatever the photograph happens to be doing behind it. */
	.case__scrim {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(
			to bottom,
			color-mix(in oklab, var(--c-bg) 70%, transparent) 0 12%,
			color-mix(in oklab, var(--c-bg) 30%, transparent) 38%,
			color-mix(in oklab, var(--c-bg) 86%, transparent) 78%,
			var(--c-bg)
		);
	}

	.case__bracket {
		position: absolute;
		inline-size: 26px;
		block-size: 26px;
		pointer-events: none;
		border-color: var(--c-entry-ink);
		opacity: 0.85;
	}

	.case__bracket--tl {
		inset-block-start: 16px;
		inset-inline-start: 16px;
		border-block-start: 2px solid;
		border-inline-start: 2px solid;
	}
	.case__bracket--tr {
		inset-block-start: 16px;
		inset-inline-end: 16px;
		border-block-start: 2px solid;
		border-inline-end: 2px solid;
	}
	.case__bracket--bl {
		inset-block-end: 16px;
		inset-inline-start: 16px;
		border-block-end: 2px solid;
		border-inline-start: 2px solid;
	}
	.case__bracket--br {
		inset-block-end: 16px;
		inset-inline-end: 16px;
		border-block-end: 2px solid;
		border-inline-end: 2px solid;
	}

	/* ---- headline -------------------------------------------------------- */

	.case__headline {
		position: relative;
		display: grid;
		gap: var(--s-4);
	}

	.case__meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2) var(--s-3);
		align-items: center;
		font-family: var(--font-mono);
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--c-text-dim);
	}

	.case__index {
		font-size: var(--t-lg);
		font-weight: 700;
		color: var(--c-entry-ink);
		line-height: 1;
	}

	.case__sep {
		color: var(--c-text-mute);
	}

	/* Same container-query sizing as the panels: an element cannot be its own
	   container, and `overflow-wrap: break-word` from the reset will split a
	   word in half rather than let it overflow. */
	.case__titlebox {
		container-type: inline-size;
	}

	.case__title {
		font-size: min(clamp(2.75rem, 1rem + 7vw, 7rem), 15cqi);
		line-height: 0.92;
		letter-spacing: -0.04em;
		text-transform: uppercase;
		text-shadow: 0 8px 40px rgb(0 0 0 / 0.85);
	}

	/* ---- idle signal bars, as on the panels ------------------------------ */

	.case__bars {
		display: inline-flex;
		align-items: flex-end;
		gap: 2px;
		block-size: 0.9em;
	}

	.case__bars i {
		inline-size: 2px;
		block-size: 100%;
		background: var(--c-entry-ink);
		transform-origin: 50% 100%;
		scale: 1 0.35;
		animation: case-bars 2.6s ease-in-out infinite;
	}

	.case__bars i:nth-child(1) {
		animation-duration: 1.7s;
		animation-delay: -0.4s;
	}
	.case__bars i:nth-child(2) {
		animation-duration: 2.3s;
		animation-delay: -1.1s;
	}
	.case__bars i:nth-child(3) {
		animation-duration: 3.1s;
		animation-delay: -0.7s;
	}
	.case__bars i:nth-child(4) {
		animation-duration: 1.9s;
		animation-delay: -1.9s;
	}

	@keyframes case-bars {
		0%,
		100% {
			scale: 1 0.3;
		}
		50% {
			scale: 1 1;
		}
	}

	/* ---- body ------------------------------------------------------------ */

	.case__body {
		display: grid;
		gap: var(--s-6);
		padding-block: var(--s-12) var(--s-8);
	}

	.case__lede {
		max-width: var(--measure);
		font-size: var(--t-lg);
		line-height: 1.45;
		color: var(--c-text);
		/* The accent bar reads as a continuation of the panel's title rule. */
		border-inline-start: 3px solid var(--c-entry-ink);
		padding-inline-start: var(--s-4);
	}

	.case__body :global(.prose) {
		max-width: var(--measure);
	}

	/* ---- links ----------------------------------------------------------- */

	.case__links ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-3);
		list-style: none;
		padding: 0;
	}

	.case__links a {
		position: relative;
		display: inline-block;
		padding: var(--s-3) var(--s-4);
		border: 1px solid color-mix(in oklab, var(--c-entry-ink) 45%, var(--c-line));
		border-radius: var(--radius);
		color: var(--c-entry-ink);
		text-decoration: none;
		overflow: clip;
		transition:
			border-color var(--speed) var(--ease),
			translate var(--speed) var(--ease);
	}

	.case__links a:hover,
	.case__links a:focus-visible {
		border-color: var(--c-entry-ink);
		translate: 0 -2px;
	}

	/* ---- sequence: this is one of several, not a dead end ---------------- */

	.case__nav {
		display: grid;
		gap: var(--s-6);
		padding-block: var(--s-8) var(--s-16);
		border-block-start: 1px solid var(--c-line);
	}

	.case__back {
		font-size: var(--t-sm);
		color: var(--c-text-dim);
		text-underline-offset: 0.3em;
	}

	.case__back:hover,
	.case__back:focus-visible {
		color: var(--c-entry-ink);
	}

	.case__sequence {
		display: grid;
		gap: var(--s-4);
	}

	.case__step {
		display: grid;
		gap: var(--s-1);
		padding: var(--s-4) var(--s-4);
		border: 1px solid var(--c-line);
		border-radius: var(--radius-lg);
		background: color-mix(in oklab, var(--c-surface) 60%, transparent);
		text-decoration: none;
		transition:
			border-color var(--speed) var(--ease),
			translate var(--speed) var(--ease);
	}

	.case__step:hover,
	.case__step:focus-visible {
		border-color: color-mix(in oklab, var(--c-entry-ink) 45%, var(--c-line));
		translate: 0 -3px;
	}

	.case__steplabel {
		font-family: var(--font-mono);
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--c-text-dim);
	}

	.case__steptitle {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--t-lg);
		letter-spacing: var(--tracking-display);
	}

	.case__step--next {
		text-align: end;
	}

	@media (min-width: 48rem) {
		.case__sequence {
			grid-template-columns: 1fr 1fr;
		}

		/* A lone "next" belongs on the right, where next always is. */
		.case__step--next:only-child {
			grid-column: 2;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.case__bars i {
			animation: none;
			scale: 1 0.7;
		}
	}
</style>
