---
import BaseLayout from '@layouts/BaseLayout.astro';
import CharacterField from '@components/CharacterField.astro';
import Section from '@components/Section.astro';
import WorkPanel from '@components/WorkPanel.astro';
import ArtSection from '@components/ArtSection.astro';
import { practice } from '@lib/practice';
import { Image } from 'astro:assets';
import artSignal from '@assets/art/lighthouse.jpg';
import artField from '@assets/art/tower.jpg';
import talkPhoto from '@assets/talk.jpg';
import aboutPhoto from '@assets/about.jpg';
import TagList from '@components/TagList.astro';
import SocialLinks from '@components/SocialLinks.astro';
import { getFeaturedWork, getPublishedWork, formatPeriod } from '@lib/work';
import { skills } from '@lib/skills';
import { site } from '@lib/site';

const featured = await getFeaturedWork();
const published = await getPublishedWork();
// Non-featured entries keep their copy somewhere, rather than being orphaned
// now that the /work index page is gone.
const also = published.filter((e) => !e.data.featured);

/*
 * The rail mirrors the document order exactly. It is built from one list so the
 * two cannot drift -- a rail dot pointing at an id that moved is a dead link
 * that nothing would catch.
 */
const rail = [
	{ id: 'top', label: 'Top' },
	{ id: featured[0]?.id ?? 'work', label: featured[0]?.data.title ?? 'Work' },
	{ id: featured[1]?.id ?? 'work-2', label: featured[1]?.data.title ?? 'Work' },
	{ id: 'interlude-signal', label: 'Interlude' },
	{ id: 'practice', label: 'How I work' },
	{ id: featured[2]?.id ?? 'work-3', label: featured[2]?.data.title ?? 'Work' },
	{ id: 'interlude-field', label: 'Interlude' },
	{ id: 'contact', label: 'Contact' },
];
---

<BaseLayout title={site.name} description={site.description}>
	<nav class="rail" data-rail aria-label="Sections">
		{rail.map((s) => (
			<a href={`#${s.id}`}>
				<span class="visually-hidden">{s.label}</span>
			</a>
		))}
	</nav>

	{/* ---- Masthead ---- */}
	<section id="top" class="section hero" aria-labelledby="top-heading" data-section>
		<CharacterField />
		<div class="hero__copy">
			<p class="hero__eyebrow">Connected TV developer</p>
			<h1 id="top-heading">Rick Groot</h1>
			<p class="lede">
				I build Connected TV apps at Triple — NLZIET on Smart TVs, Chromecast receivers, and the
				video players underneath them. Most of it is performance work: the devices they run on are
				older and slower than the machine I write on.
			</p>
			<TagList tags={skills} label="What I work on" />
		</div>
		<p class="hero__cue" aria-hidden="true">
			Scroll
		</p>
	</section>

	{/* ---- Work and interludes, interleaved ---- */}
	{featured[0] && (
		<Section
			id={featured[0].id}
			label={featured[0].data.title}
			labelHidden={true}
			accent={featured[0].data.accent}
			class="section--work"
		>
			<WorkPanel entry={featured[0]} index="01" />
		</Section>
	)}

	{featured[1] && (
		<Section
			id={featured[1].id}
			label={featured[1].data.title}
			labelHidden={true}
			accent={featured[1].data.accent}
			class="section--work"
		>
			<WorkPanel entry={featured[1]} index="02" />
		</Section>
	)}

	<ArtSection
		id="interlude-signal"
		image={artSignal}
		alt="A lighthouse and a small group of people silhouetted against a sunset over a bay."
		focus="40% 50%"
		brightness={0.68}
		statement="A TV app has to feel fast on hardware that shipped years before the app did."
		caption="Interlude / Signal"
		tone="cool"
	/>

	{/* ---- How I work ---- */}
	<Section id="practice" label="How I work" index="03" class="section--backdrop">
		{/* Rick presenting, standing at the left; his three points sit to his */}
		{/* right on wide screens, so the cards never cover his face. The slide */}
		{/* and both audience members are blurred in the source file itself. */}
		<div class="practice__backdrop">
			<Image
				src={talkPhoto}
				alt="Rick giving a talk about AI-assisted development."
				widths={[800, 1200, 1600]}
				sizes="100vw"
				loading="lazy"
				decoding="async"
			/>
			<span class="practice__dither" aria-hidden="true"></span>
			<span class="practice__scrim" aria-hidden="true"></span>
		</div>
		<p class="practice__lede">
			Three things that happened while building this site, with the numbers.
		</p>
		<ol class="practice">
			{practice.map((item) => (
				<li class="practice__item" data-proximity>
					<p class="practice__index" aria-hidden="true">
						{item.index}
					</p>
					<h3 class="practice__title">{item.title}</h3>
					<p class="practice__body">{item.body}</p>
					<p class="practice__proof">{item.proof}</p>
				</li>
			))}
		</ol>
	</Section>

	{featured[2] && (
		<Section
			id={featured[2].id}
			label={featured[2].data.title}
			labelHidden={true}
			accent={featured[2].data.accent}
			class="section--work"
		>
			<WorkPanel entry={featured[2]} index="04" />
		</Section>
	)}

	<ArtSection
		id="interlude-field"
		image={artField}
		alt="A stone clock tower against a bright, empty sky."
		focus="36% 45%"
		statement="Every measurement quoted on this site can be re‑run from the repository."
		caption="Interlude / Field"
		tone="hot"
	/>

	{/* ---- Contact ---- */}
	<Section id="contact" label="Contact" index="05">
		<div class="contact">
			<div class="contact__text">
				<p class="lede">
					Email is easiest. Happy to talk about Connected TV work — or the trumpet, if you would
					rather.
				</p>
				<SocialLinks />

				{also.length > 0 && (
					<div class="also">
						<h3 class="also__title">Also shipped</h3>
						<ul>
							{also.map((e) => (
								<li>
									<a href={`/work/${e.id}`}>{e.data.title}</a>
									<span>
										{e.data.role} · {e.data.company} · {formatPeriod(e)}
									</span>
								</li>
							))}
						</ul>
					</div>
				)}
			</div>
			<figure class="contact__photo">
				<Image
					src={aboutPhoto}
					alt="Rick Groot, smiling, on a bridge by a canal."
					widths={[500, 800, 1000]}
					sizes="(min-width: 52rem) 30vw, 90vw"
					loading="lazy"
					decoding="async"
				/>
				<span class="contact__dither" aria-hidden="true"></span>
			</figure>
		</div>
	</Section>

	<script>
		import { boot } from '../scripts/sections';
		boot();
	</script>
</BaseLayout>

<style>
	/* ---- Masthead -------------------------------------------------------- */

	.hero {
		position: relative;
		display: grid;
		align-content: center;
		min-block-size: 100svh;
		/* Full bleed, so the field can fill the whole screen. */
		margin-inline: calc(50% - 50vw);
		overflow: clip;
	}

	/* Scrim. A static gradient, painted once — never animated. */
	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background:
			linear-gradient(
				100deg,
				var(--c-bg) 0 30%,
				color-mix(in oklab, var(--c-bg) 45%, transparent) 55%,
				transparent 80%
			),
			linear-gradient(to bottom, var(--c-bg), transparent 14%, transparent 84%, var(--c-bg));
	}

	.hero__copy {
		position: relative;
		z-index: 2;
		display: grid;
		gap: var(--s-6);
		/* Same formula as .wrap, so the left edge lines up with every section */
		/* below. --measure goes on the children, not on this box. */
		width: min(100% - var(--gutter) * 2, var(--wrap));
		margin-inline: auto;
	}

	.hero__copy > * {
		max-width: var(--measure);
	}

	.hero__eyebrow {
		font-family: var(--font-mono);
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--c-cool);
	}

	.hero__copy h1 {
		font-size: var(--t-3xl);
		letter-spacing: var(--tracking-display);
	}

	.hero__cue {
		position: absolute;
		z-index: 2;
		inset-block-end: var(--s-8);
		inset-inline-start: 50%;
		translate: -50% 0;
		font-family: var(--font-mono);
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--c-text-mute);
		animation: cue 2.4s ease-in-out infinite;
	}

	@keyframes cue {
		0%,
		100% {
			translate: -50% 0;
			opacity: 0.5;
		}
		50% {
			translate: -50% 6px;
			opacity: 1;
		}
	}

	.lede {
		font-size: var(--t-lg);
		color: var(--c-text-dim);
	}

	/* ---- How I work: a three-up horizontal grid --------------------------- */

	/* The talk, full-bleed behind the section. Positioned against .section, */
	/* which is the nearest positioned ancestor; .section--backdrop isolates it */
	/* so a z-index of -1 lands above the section's own background instead of */
	/* below it. */
	.practice__backdrop {
		position: absolute;
		inset: 0;
		z-index: -1;
		overflow: clip;
	}

	.practice__backdrop :global(img) {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		/* Rick sits at ~18% across; on a phone this keeps him in the narrow */
		/* centre band a cover crop leaves. */
		object-position: 18% 45%;
		filter: grayscale(1) contrast(1.15) brightness(0.5);
	}

	.practice__dither {
		position: absolute;
		inset: 0;
		background-image:
			radial-gradient(circle at 25% 25%, var(--c-bg) 0.9px, transparent 1.1px),
			radial-gradient(circle at 75% 75%, var(--c-bg) 0.9px, transparent 1.1px);
		background-size: 3px 3px;
		opacity: 0.7;
	}

	/* Darker where the text is, lighter where Rick is. */
	.practice__scrim {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				to bottom,
				color-mix(in oklab, var(--c-bg) 72%, transparent) 0 24%,
				transparent 48%
			),
			linear-gradient(
				to right,
				transparent 0 22%,
				color-mix(in oklab, var(--c-bg) 62%, transparent) 46%
			);
	}

	.practice__lede {
		font-size: var(--t-lg);
		color: var(--c-text-dim);
		max-width: var(--measure);
	}

	.practice {
		display: grid;
		gap: var(--s-6);
		list-style: none;
		padding: 0;
		margin-block-start: var(--s-8);
		counter-reset: none;
	}

	.practice__item {
		display: grid;
		grid-template-rows: auto auto 1fr auto;
		gap: var(--s-3);
		padding: var(--s-6);
		border: 1px solid var(--c-line);
		border-radius: var(--radius-lg);
		background: color-mix(in oklab, var(--c-surface) 70%, transparent);
		transition:
			border-color var(--speed) var(--ease),
			translate var(--speed) var(--ease);
	}

	.practice__item:hover,
	.practice__item:focus-within {
		border-color: color-mix(in oklab, var(--c-cool) 40%, var(--c-line));
		translate: 0 -4px;
	}

	.practice__index {
		font-family: var(--font-mono);
		font-size: var(--t-lg);
		font-weight: 700;
		color: var(--c-cool);
		line-height: 1;
	}

	.practice__title {
		font-size: var(--t-xl);
		letter-spacing: var(--tracking-display);
	}

	.practice__body {
		color: var(--c-text-dim);
	}

	/* The checkable detail. Set apart, because it is the thing that stops the */
	/* card being a slogan. */
	.practice__proof {
		margin-block-start: var(--s-2);
		padding-block-start: var(--s-3);
		border-block-start: 1px solid var(--c-line);
		font-size: var(--t-sm);
		color: var(--c-text-mute);
	}

	/* Three stacked cards will always exceed a phone, and that is fine -- the */
	/* advance script scrolls an overflowing section normally before advancing. */
	/* Tightened so the overshoot is a short scroll rather than a long one. */
	@media (max-width: 51.99rem) {
		.practice {
			gap: var(--s-3);
			margin-block-start: var(--s-6);
		}

		.practice__item {
			padding: var(--s-4);
			gap: var(--s-2);
		}

		.practice__title {
			font-size: var(--t-lg);
		}

		.practice__body,
		.practice__proof {
			font-size: var(--t-sm);
		}
	}

	@media (min-width: 52rem) {
		.practice {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: var(--s-4);
		}

		.practice__item {
			padding: var(--s-4);
			gap: var(--s-2);
		}

		.practice__title {
			font-size: var(--t-lg);
		}

		.practice__body {
			font-size: var(--t-sm);
		}

		.practice__proof {
			font-size: var(--t-xs);
		}
	}

	/* Four columns, cards in the last three: the first is left clear for Rick, */
	/* so he is presenting his three points rather than hidden behind them. Only */
	/* from 76rem, because below that the cards get too narrow: 1024x768 */
	/* overran by 60px and 1152x720 by 19px. Tablets get three full-width columns over the backdrop. */
	@media (min-width: 76rem) {
		.practice {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.practice__item:first-child {
			grid-column: 2;
		}
	}

	/* A 720px-tall desktop is the shortest one in common use, and the four-column */
	/* layout overran it by 21px. Tightened only where the height is actually */
	/* short, rather than shrinking the type for every screen to pay for it. */
	@media (min-width: 76rem) and (max-height: 760px) {
		.practice {
			margin-block-start: var(--s-4);
		}

		.practice__item {
			padding: var(--s-3) var(--s-4);
		}
	}

	/* ---- Contact --------------------------------------------------------- */

	.contact {
		display: grid;
		gap: var(--s-8);
		align-items: start;
	}

	.contact__text {
		display: grid;
		gap: var(--s-8);
		max-width: var(--measure);
	}

	.contact__photo {
		position: relative;
		margin: 0;
		overflow: clip;
		border-radius: var(--radius-lg);
		border: 1px solid var(--c-line);
		aspect-ratio: 4 / 5;
		/* On a phone the photo stacks under the text; at full width it pushed the */
		/* last section 104px past the screen. Supporting, not the headline. */
		max-inline-size: min(16rem, 100%);
	}

	.contact__photo :global(img) {
		display: block;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		filter: grayscale(1) contrast(1.1);
	}

	.contact__dither {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background-image:
			radial-gradient(circle at 25% 25%, var(--c-bg) 0.9px, transparent 1.1px),
			radial-gradient(circle at 75% 75%, var(--c-bg) 0.9px, transparent 1.1px);
		background-size: 3px 3px;
		opacity: 0.55;
	}

	@media (min-width: 52rem) {
		.contact {
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		}

		.contact__photo {
			justify-self: end;
			max-inline-size: 26rem;
		}
	}

	.also__title {
		font-size: var(--t-sm);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--c-text-dim);
		margin-block-end: var(--s-3);
	}

	.also ul {
		display: grid;
		gap: var(--s-3);
		list-style: none;
		padding: 0;
		border-block-start: 1px solid var(--c-line);
		padding-block-start: var(--s-4);
	}

	.also li {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-1) var(--s-3);
		align-items: baseline;
	}

	.also span {
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--c-text-mute);
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__cue {
			animation: none;
		}
	}
</style>
