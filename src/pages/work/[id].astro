---
import { render } from 'astro:content';
import WorkLayout from '@layouts/WorkLayout.astro';
import { getPublishedWork, type PublishedWorkEntry } from '@lib/work';

export async function getStaticPaths() {
	// EVERY published entry, not just featured. `featured` controls what gets
	// a section on the one-pager; it must not decide whether a case study is
	// reachable at all. KIJK is not featured and still deserves a URL.
	const entries = await getPublishedWork();
	const ids = entries.map((e) => e.id).sort();

	// Deliberately annoying guard. Adding a work page should be an explicit,
	// reviewed edit -- not something that happens quietly because a `featured`
	// flag was flipped. A typo in the frontmatter breaks the build here rather
	// than silently dropping a page from the site (and from the sitemap).
	const expected = ['chromecast', 'kijk', 'nlziet', 'vamp'];
	if (ids.join(',') !== expected.join(',')) {
		throw new Error(
			`Expected featured work pages [${expected.join(', ')}], got [${ids.join(', ')}]. ` +
				`If this change is intended, update the guard in src/pages/work/[id].astro ` +
				`and docs/content-guide.md.`,
		);
	}

	// Position in the published order, so the number on a case study is the
	// same number its panel carries on the one-pager.
	return entries.map((entry, i) => ({
		params: { id: entry.id },
		props: {
			entry,
			index: String(i + 1).padStart(2, '0'),
			prev: entries[i - 1],
			next: entries[i + 1],
		},
	}));
}

interface Props {
	entry: PublishedWorkEntry;
	index: string;
	prev?: PublishedWorkEntry | undefined;
	next?: PublishedWorkEntry | undefined;
}

const { entry, index, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<WorkLayout entry={entry} index={index} prev={prev} next={next}>
	<Content />
</WorkLayout>
