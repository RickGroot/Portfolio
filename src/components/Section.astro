---
import { channelStyle, type Channel } from '@lib/channels';

interface Props {
	id: string;
	label: string;
	/** Rendered as a visible heading, or hidden when the section has its own. */
	labelHidden?: boolean | undefined;
	index?: string | undefined;
	/**
	 * The channel this section is broadcast on. Required: every full-screen
	 * section is a channel, and a section that quietly inherited the page's
	 * colours would break the one idea the design is built on.
	 */
	channel: Channel;
	class?: string | undefined;
}

const { id, label, labelHidden = false, index, channel, class: cls = '' } = Astro.props;
---

<section
	id={id}
	class:list={['section', cls]}
	aria-labelledby={`${id}-heading`}
	data-section
	data-channel={channel}
	style={channelStyle(channel)}
>
	<div class="section__inner wrap">
		<header class="section__head">
			{index && (
				<span class="section__index" aria-hidden="true">
					{index}
				</span>
			)}
			<h2 id={`${id}-heading`} class:list={{ 'visually-hidden': labelHidden }}>
				{label}
			</h2>
		</header>
		<slot />
	</div>
</section>
