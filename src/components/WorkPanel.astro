---
import { Image } from 'astro:assets';
import TagList from './TagList.astro';
import { formatPeriod, type PublishedWorkEntry } from '@lib/work';
import { ink } from '@lib/accent';

interface Props {
	entry: PublishedWorkEntry;
	index: string;
}

const { entry, index } = Astro.props;
const { title, role, company, summary, tags, accent, cover } = entry.data;
---

<div
	class="panel"
	data-proximity
	style={`--c-entry-accent:${accent}; --c-entry-ink:${ink(accent)}`}
>
	<a class="panel__media" href={`/work/${entry.id}`} tabindex="-1" aria-hidden="true">
		<Image
			src={cover}
			alt=""
			widths={[600, 1000, 1600]}
			sizes="(min-width: 60rem) 46vw, 92vw"
			loading={index === '01' ? 'eager' : 'lazy'}
			decoding="async"
		/>
		{/* Ordered-dither overlay. Resolves out on hover / focus -- the same
		    "signal into clarity" idea as the hero, at a fraction of the cost. */}
		<span class="panel__dither" aria-hidden="true"></span>
		<span class="panel__scanline" aria-hidden="true"></span>
	</a>

	<div class="panel__body">
		<p class="panel__meta">
			<span class="panel__index" aria-hidden="true">
				{index}
			</span>
			<span>{role}</span> · <span>{company}</span> · <span>{formatPeriod(entry)}</span>
		</p>

		<h3 class="panel__title">
			<a href={`/work/${entry.id}`}>
				{title}
				<span class="panel__rule" aria-hidden="true"></span>
			</a>
		</h3>

		<p class="panel__summary">{summary}</p>
		<TagList tags={tags} />

		<p class="panel__more">
			<a href={`/work/${entry.id}`}>
				Read the case study <span aria-hidden="true">→</span>
			</a>
		</p>
	</div>
</div>

<style>
	.panel {
		display: grid;
		gap: var(--s-8);
		align-items: center;
		width: 100%;
	}

	@media (min-width: 60rem) {
		.panel {
			grid-template-columns: 1.05fr 1fr;
			gap: var(--s-16);
		}
	}

	/* ---- media ---------------------------------------------------------- */

	.panel__media {
		position: relative;
		display: block;
		overflow: clip;
		border-radius: var(--radius-lg);
		border: 1px solid var(--c-line);
		background: var(--c-surface);
		/* The link is decorative -- the real one is the title. Keep it out of */
		/* the tab order rather than making a keyboard user pass two links to */
		/* reach one destination. */
		isolation: isolate;
	}

	.panel__media :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		transition:
			scale var(--speed-slow) var(--ease-out),
			filter var(--speed-slow) var(--ease-out);
		filter: saturate(0.72) contrast(1.06);
	}

	/* The dither. */
	/* Two offset dot grids in the page background colour, punched over the */
	/* image. At 3px they read as an ordered dither rather than a texture. Only */
	/* `opacity` animates, so this is compositor-only -- never animate */
	/* background-size or background-position here. */
	.panel__dither {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background-image:
			radial-gradient(circle at 25% 25%, var(--c-bg) 0.9px, transparent 1.1px),
			radial-gradient(circle at 75% 75%, var(--c-bg) 0.9px, transparent 1.1px);
		background-size: 3px 3px;
		opacity: 0.92;
		transition: opacity var(--speed-slow) var(--ease-out);
	}

	/* A slow idle drift, so the panel is never completely dead. Transform only. */
	.panel__scanline {
		position: absolute;
		inset: -20% 0;
		pointer-events: none;
		background: linear-gradient(
			to bottom,
			transparent 0%,
			color-mix(in oklab, var(--c-entry-ink) 14%, transparent) 48%,
			transparent 60%
		);
		opacity: 0;
		transition: opacity var(--speed-slow) var(--ease-out);
		animation: drift 9s linear infinite;
	}

	@keyframes drift {
		from {
			translate: 0 -30%;
		}
		to {
			translate: 0 30%;
		}
	}

	/* Hover AND focus-within: the keyboard path gets the identical reveal. */
	.panel:hover .panel__dither,
	.panel:focus-within .panel__dither {
		opacity: 0;
	}

	.panel:hover .panel__scanline,
	.panel:focus-within .panel__scanline {
		opacity: 1;
	}

	.panel:hover .panel__media :global(img),
	.panel:focus-within .panel__media :global(img) {
		scale: 1.03;
		filter: saturate(1) contrast(1);
	}

	/* ---- body ------------------------------------------------------------ */

	.panel__body {
		display: grid;
		gap: var(--s-4);
		max-width: var(--measure);
	}

	.panel__meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2);
		align-items: baseline;
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--c-text-dim);
	}

	.panel__index {
		font-variant-numeric: tabular-nums;
		color: var(--c-entry-ink);
	}

	.panel__title {
		font-size: var(--t-2xl);
		letter-spacing: var(--tracking-display);
	}

	.panel__title a {
		position: relative;
		text-decoration: none;
	}

	.panel__rule {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.12em;
		height: 2px;
		background: var(--c-entry-ink);
		transform: scaleX(0);
		transform-origin: 100% 50%;
		transition: transform var(--speed) var(--ease);
	}

	/* Draws from the left, wipes out to the right — the asymmetry is what */
	/* makes it read as deliberate rather than a toggle. */
	.panel__title a:hover .panel__rule,
	.panel__title a:focus-visible .panel__rule {
		transform: scaleX(1);
		transform-origin: 0 50%;
	}

	.panel__summary {
		color: var(--c-text-dim);
		font-size: var(--t-lg);
	}

	.panel__more {
		margin-block-start: var(--s-2);
		font-size: var(--t-sm);
	}

	.panel__more a {
		color: var(--c-entry-ink);
		text-underline-offset: 0.3em;
	}

	@media (prefers-reduced-motion: reduce) {
		/* The dither is a state indicator, so it stays — it just arrives */
		/* instantly. The idle drift is autonomous motion, so it goes. */
		.panel__scanline {
			animation: none;
		}
	}
</style>
