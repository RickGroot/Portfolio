---
import { linkProps } from '@lib/links';

/** A back's links: real anchors, printed in the card's pigment. Nothing when there are none. */
interface Props {
	/** `sr` is read after the label by screen readers only, when the label alone repeats across cards. */
	links: { label: string; href: string; sr?: string }[];
	/** The card's name: the default `sr`, so two "Source" links read "Source: VAMP" and "Source: Sleeve". */
	of?: string;
}
const { links, of } = Astro.props;
---

{links.length > 0 && (
	<ul class="links">
		{links.map((l) => (
			<li>
				<a class="go" href={l.href} {...linkProps(l.href)}>
					{l.label}
					{(l.sr ?? of) && <span class="visually-hidden">: {l.sr ?? of}</span>}
				</a>
			</li>
		))}
	</ul>
)}
