---
import { socialLinks } from '@lib/social';
import { publicPath } from '@lib/site';

const path = publicPath(Astro.url.pathname);
const onHome = path === '/';
const email = socialLinks.find((l) => l.href.startsWith('mailto:'));
---

<nav aria-label="Primary">
	<a href="/" class="mark" aria-current={onHome ? 'page' : undefined}>
		<span class="mark__name">Rick Groot</span>
		<span class="mark__role">Connected TV developer</span>
	</a>

	<div class="actions">
		{
			/* On a detail page this goes back to the narrative; on the one-pager
			   it is a same-page jump. Either way it is a real link. */
			!onHome && (
				<a class="link" href="/">
					<span aria-hidden="true">←</span> Overview
				</a>
			)
		}
		{email && (
			<a class="cta" href={email.href}>
				Email
			</a>
		)}
	</div>
</nav>

<style>
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--s-6);
		padding-block: var(--s-4);
	}

	.mark {
		display: grid;
		gap: 1px;
		text-decoration: none;
		line-height: 1.1;
	}

	.mark__name {
		font-family: var(--font-display);
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.mark__name {
		transition: color var(--speed) var(--ease);
	}

	.mark:hover .mark__name,
	.mark:focus-visible .mark__name {
		color: var(--accent);
	}

	.mark__role {
		font-family: var(--font-mono);
		font-size: var(--t-xs);
		letter-spacing: var(--tracking-meta);
		text-transform: uppercase;
		color: var(--mark-dim);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: var(--s-4);
	}

	.link {
		font-size: var(--t-sm);
		color: var(--mark-dim);
		text-decoration: none;
		white-space: nowrap;
	}

	/* A phone cannot fit the name, the role, the way back and the button on */
	/* one line: the arrow was wrapping away from its own label. The role is */
	/* the one to drop -- every page says it again in its own content. */
	@media (max-width: 30rem) {
		.mark__role {
			display: none;
		}
	}

	.link:hover,
	.link:focus-visible {
		color: var(--mark);
	}

	/*
	 * A button shape, not another text link.
	 *
	 * The nav reference that was disliked had "unclear navigation" -- you could
	 * not tell what the options were. A different KIND of thing should look
	 * different, so the one action on the page is shaped like an action and the
	 * navigation is shaped like navigation. Nothing has to be guessed.
	 */
	/* Drawn in the page's channel. The nav sits at the top of the page, above */
	/* every section, so the page channel is the one it is always seen on. */
	.cta {
		--nav-ink: var(--mark);
		transition-property: background-color, color, border-color;
		font-size: var(--t-sm);
		font-weight: 700;
		padding: var(--s-2) var(--s-4);
		border: 1px solid var(--nav-ink);
		color: var(--nav-ink);
		text-decoration: none;
		transition:
			background-color var(--speed) var(--ease),
			color var(--speed) var(--ease);
		/* 44px touch target. */
		min-block-size: 44px;
		display: inline-flex;
		align-items: center;
	}

	.cta:hover,
	.cta:focus-visible {
		background: var(--nav-ink);
		color: var(--field);
	}
</style>
