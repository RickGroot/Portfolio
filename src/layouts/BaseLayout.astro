---
import BaseHead from '@components/BaseHead.astro';
import { site, type ShareImage } from '@lib/site';
import { PALETTE, paletteStyle } from '@lib/palette';

// The ONE place global.css is imported. See CLAUDE.md.
import '@styles/global.css';

interface Props {
	title: string;
	description?: string | undefined;
	ogImage?: ShareImage | undefined;
	/** schema.org structured data for the page (BaseHead). */
	jsonLd?: Record<string, unknown> | undefined;
	noindex?: boolean | undefined;
}

const { title, description = site.description, ogImage, jsonLd, noindex } = Astro.props;
---

<!doctype html>
<html lang={site.locale} style={paletteStyle()}>
	<head>
		<BaseHead
			title={title}
			description={description}
			ogImage={ogImage}
			jsonLd={jsonLd}
			noindex={noindex}
			themeColor={PALETTE.paper}
		/>
		{/* `js`: the cards can turn (without it, CSS lays each back out under its */}
		{/* front). `still`: the visitor paused the motion on an earlier visit. */}
		{/* The deal: hide the cards until the script has laid them out, unless */}
		{/* motion is off. Three seconds later it lets go whatever happened, so a */}
		{/* script that fails cannot leave a blank page. */}
		<script is:inline>
			var root = document.documentElement;
			root.classList.add('js');
			try {
				if (localStorage.getItem('still') === '1') root.classList.add('still');
			} catch (e) {}
			if (
				!root.classList.contains('still') &&
				!matchMedia('(prefers-reduced-motion: reduce)').matches
			) {
				document.documentElement.classList.add('will-deal');
				setTimeout(function () {
					document.documentElement.classList.remove('will-deal');
				}, 3000);
			}
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">
			Skip to content
		</a>
		<main id="main" tabindex="-1">
			<slot />
		</main>

		<script>
			import '../scripts/table';
		</script>
	</body>
</html>
